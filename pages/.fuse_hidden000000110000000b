<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1A1A2E" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%237C3AED'/><text x='16' y='22' font-family='Georgia,serif' font-size='13' font-weight='700' fill='white' text-anchor='middle'>TvZ</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://www.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700&display=swap" />
  <script src="../theme.js"></script>
  <link rel="stylesheet" href="../style.css" />
  <title>Planner — TVZA</title>
  <style>
    /* ══════════════════════════════════════════════════════════════
       Planner — v4 polish + tasteful, smooth animations (scoped)
    ══════════════════════════════════════════════════════════════ */

    /* ── Animation keyframes ── */
    @keyframes viewIn   { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    @keyframes cardIn   { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
    @keyframes rowIn    { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }
    @keyframes popIn    { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: scale(1); } }
    @keyframes slideUp  { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
    @keyframes pulseDot { 0%,80%,100% { opacity: .25; transform: scale(.7); } 40% { opacity: 1; transform: scale(1); } }
    @keyframes flashOk  { 0% { transform: scale(1); } 35% { transform: scale(1.12); } 100% { transform: scale(1); } }
    @keyframes barFlow  { from { background-position: 0 0; } to { background-position: 200% 0; } }
    @keyframes ripple   { from { transform: scale(0); opacity: .45; } to { transform: scale(2.4); opacity: 0; } }

    /* ── View enter animation ── */
    .view-in { animation: viewIn .32s cubic-bezier(.22,.61,.36,1) both; }

    /* ── Animated accent bar (subtle flowing gradient) ── */
    .accent-bar--trip {
      background: linear-gradient(90deg,
        var(--tint-trip), var(--trip), var(--tint-trip));
      background-size: 200% 100%;
      animation: barFlow 6s linear infinite;
    }

    /* ── Language selector ── */
    .lang-sel {
      font-size: 13px; font-family: inherit; cursor: pointer;
      padding: 4px 6px; border-radius: 6px;
      border: 1px solid rgba(255,255,255,0.22); background: rgba(255,255,255,0.12);
      color: #fff; min-height: 36px;
      transition: background .15s ease, transform .15s ease;
    }
    .lang-sel option { color: #1a1a2e; }
    .lang-sel:hover  { background: rgba(255,255,255,0.2); }
    .lang-sel:focus  { outline: 2px solid #fff; outline-offset: 2px; }

    /* ── Pill action buttons ── */
    .action-row { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
    .pill-btn {
      position: relative; overflow: hidden;
      font-size: 11px; font-weight: 600; padding: 6px 12px;
      border-radius: 999px; border: 1px solid var(--border);
      background: var(--surface-2); color: var(--ink);
      cursor: pointer; white-space: nowrap;
      display: inline-flex; align-items: center; gap: 4px;
      transition: background .18s ease, border-color .18s ease, color .18s ease,
                  transform .12s ease, box-shadow .18s ease;
    }
    .pill-btn:hover  { background: var(--accent-bg); border-color: var(--accent); color: var(--accent);
                       transform: translateY(-1px); box-shadow: var(--shadow-sm); }
    .pill-btn:active { transform: scale(.94); }
    .pill-btn.flash  { animation: flashOk .4s ease; color: var(--food-deep); border-color: var(--food); }
    .pill-btn .rip   { position: absolute; border-radius: 50%; background: currentColor;
                       width: 16px; height: 16px; pointer-events: none; animation: ripple .55s ease-out forwards; }
    .pill-btn--primary { font-weight: 700; border-color: var(--trip); color: var(--trip-deep);
                         background: var(--tint-trip); }

    /* ── Button micro-feedback ── */
    .btn { position: relative; overflow: hidden; }
    .btn .rip { position: absolute; border-radius: 50%; background: rgba(255,255,255,.5);
                width: 20px; height: 20px; pointer-events: none; animation: ripple .6s ease-out forwards; }
    .btn-primary { box-shadow: 0 2px 8px oklch(0.45 0.09 60 / 0.18); }
    .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 4px 14px oklch(0.45 0.09 60 / 0.26); }

    /* ── Cards animate in ── */
    .form-card { animation: cardIn .4s cubic-bezier(.22,.61,.36,1) both; }
    .trip-card { animation: cardIn .42s cubic-bezier(.22,.61,.36,1) both;
                 animation-delay: calc(var(--i, 0) * 55ms); }
    .trip-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }

    /* ── Invite / share strip ── */
    .invite-strip {
      display: flex; gap: 8px; align-items: center; margin-top: 12px;
      padding: 9px 11px; border-radius: 10px;
      background: var(--surface-2); border: 1px solid var(--border);
      animation: popIn .3s ease both;
    }
    .invite-strip span {
      flex: 1; font-size: 11px; color: var(--ink-soft);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .invite-strip button {
      font-size: 11px; font-weight: 700; padding: 6px 12px;
      border-radius: 999px; border: 1px solid var(--accent);
      background: var(--accent-bg); color: var(--accent); cursor: pointer; white-space: nowrap;
      transition: transform .12s ease, background .15s ease;
    }
    .invite-strip button:active { transform: scale(.93); }
    .invite-strip button.flash { animation: flashOk .4s ease; }

    /* ── Pending / member rows ── */
    .pending-card {
      display: flex; align-items: center; gap: 8px;
      padding: 8px 0; border-bottom: 1px solid var(--border);
      animation: rowIn .3s ease both;
    }
    .pending-card:last-child { border-bottom: none; }

    /* ── Reminder banner ── */
    .reminder-card {
      background: linear-gradient(135deg, var(--tint-trip), var(--surface));
      border: 1px solid var(--trip);
      border-radius: var(--r2); padding: 14px 16px; margin-bottom: var(--s4);
      box-shadow: var(--shadow-sm); animation: slideUp .4s cubic-bezier(.22,.61,.36,1) both;
      position: relative;
    }
    .reminder-head { display: flex; align-items: center; gap: 8px; font-weight: 700;
                     font-size: 14px; color: var(--trip-deep); margin-bottom: 8px; }
    .reminder-bell { display: inline-block; transform-origin: 50% 0;
                     animation: bell 2.4s ease infinite; }
    @keyframes bell { 0%,92%,100% { transform: rotate(0); } 94% { transform: rotate(14deg); }
                      96% { transform: rotate(-12deg); } 98% { transform: rotate(8deg); } }
    .reminder-item { font-size: 13px; color: var(--ink); padding: 4px 0;
                     display: flex; align-items: center; gap: 8px; animation: rowIn .35s ease both; }
    .reminder-item .when { margin-left: auto; font-weight: 700; font-size: 12px; color: var(--trip-deep);
                           background: var(--surface); padding: 2px 9px; border-radius: 999px;
                           border: 1px solid var(--trip); }
    .reminder-close { position: absolute; top: 10px; right: 12px; cursor: pointer;
                      color: var(--ink-soft); font-size: 16px; line-height: 1; background: none; border: none; }

    /* ── Itinerary timeline ── */
    .itin-day { margin-top: 14px; animation: cardIn .4s ease both;
                animation-delay: calc(var(--d, 0) * 70ms); }
    .itin-day-head {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 12px; font-weight: 700; letter-spacing: .03em;
      color: var(--trip-deep); background: var(--tint-trip);
      padding: 4px 12px; border-radius: 999px; margin-bottom: 6px;
    }
    .itin-line { position: relative; padding-left: 20px; }
    .itin-line::before {
      content: ''; position: absolute; left: 5px; top: 4px; bottom: 4px;
      width: 2px; background: var(--border); border-radius: 2px;
    }
    .itin-item {
      position: relative; padding: 8px 10px; margin-bottom: 7px;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; box-shadow: var(--shadow-sm);
      display: flex; align-items: flex-start; gap: 10px;
      animation: rowIn .35s ease both; animation-delay: calc(var(--ii, 0) * 45ms);
      transition: transform .14s ease, box-shadow .14s ease;
    }
    .itin-item:hover { transform: translateX(2px); box-shadow: var(--shadow-md); }
    .itin-item::before {
      content: ''; position: absolute; left: -17px; top: 14px;
      width: 9px; height: 9px; border-radius: 50%;
      background: var(--trip); border: 2px solid var(--surface);
      box-shadow: 0 0 0 2px var(--tint-trip);
    }
    .itin-time { font-size: 12px; font-weight: 700; color: var(--trip-deep);
                 min-width: 44px; padding-top: 1px; }
    .itin-body { flex: 1; min-width: 0; }
    .itin-title { font-size: 14px; font-weight: 600; }
    .itin-notes { font-size: 12px; color: var(--ink-soft); margin-top: 2px; white-space: pre-wrap; }
    .itin-del { background: none; border: none; color: var(--ink-soft); cursor: pointer;
                font-size: 14px; padding: 2px 4px; transition: color .15s ease, transform .12s ease; }
    .itin-del:hover  { color: var(--danger); }
    .itin-del:active { transform: scale(.85); }

    /* ── Plan attach options ── */
    .plan-tabs { display: flex; gap: 6px; margin: 10px 0 12px; }
    .plan-tab {
      flex: 1; font-size: 12px; font-weight: 600; padding: 8px;
      border-radius: var(--r1); border: 1px solid var(--border);
      background: var(--surface-2); color: var(--ink-soft); cursor: pointer;
      transition: all .15s ease;
    }
    .plan-tab.active { background: var(--tint-trip); color: var(--trip-deep);
                       border-color: var(--trip); }
    .plan-pane { display: none; animation: popIn .25s ease both; }
    .plan-pane.active { display: block; }
    .file-drop {
      border: 2px dashed var(--border); border-radius: var(--r2);
      padding: 22px 14px; text-align: center; cursor: pointer;
      color: var(--ink-soft); font-size: 13px;
      transition: border-color .18s ease, background .18s ease, color .18s ease;
    }
    .file-drop:hover, .file-drop.drag { border-color: var(--trip); background: var(--tint-trip);
                                        color: var(--trip-deep); }
    .file-drop strong { color: var(--trip-deep); }

    /* ── Animated spinner (dots) ── */
    .spinner { display: flex; gap: 6px; align-items: center; justify-content: center; }
    .spinner::after { content: none; }
    .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--trip);
           animation: pulseDot 1.1s ease-in-out infinite; }
    .dot:nth-child(2) { animation-delay: .15s; }
    .dot:nth-child(3) { animation-delay: .3s; }

    /* ── Activity items animate ── */
    .item-card { animation: rowIn .32s ease both; animation-delay: calc(var(--i, 0) * 45ms); }

    /* ── Plan viewer modal (full-screen iframe overlay) ── */
    #planModal {
      display: none; position: fixed; inset: 0; z-index: 9999;
      flex-direction: column; background: var(--bg);
    }
    #planModal.visible { display: flex; animation: viewIn .28s ease both; }
    #planModal.visible #planFrame { animation: slideUp .4s cubic-bezier(.22,.61,.36,1) both; }
    .plan-bar {
      display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; border-bottom: 1px solid var(--border);
      background: var(--brand-gradient); color: #fff; flex-shrink: 0;
    }
    .plan-bar .btn-secondary { background: rgba(255,255,255,.14); color: #fff;
                               border-color: rgba(255,255,255,.25); }
    .plan-bar-title { font-weight: 700; font-size: 15px; flex: 1; overflow: hidden;
      text-overflow: ellipsis; white-space: nowrap; }
    .plan-bar a { color: #fff !important; }
    #planFrame { flex: 1; border: none; width: 100%; height: 100%; background: #fff; }

    /* ── Reduced motion: respect user preference ── */
    @media (prefers-reduced-motion: reduce) {
      * { animation-duration: .001ms !important; animation-iteration-count: 1 !important; }
      .accent-bar--trip, .reminder-bell { animation: none; }
    }
  </style>
  <link rel="stylesheet" href="../ui-fx.css?v=7" />
  <script src="../ui-fx.js?v=7" defer></script>
</head>
<body>
  <div class="app">

    <div class="offline-banner" id="offlineBanner"></div>

    <header class="header">
      <div class="header-inner" style="position:relative">
        <a href="../index.html" class="back-btn" id="backBtn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
          <span id="backLabel">Back</span>
        </a>
        <span class="page-title" id="pageTitle">Planner</span>
        <div style="margin-left:auto;display:flex;align-items:center;gap:6px">
          <select class="lang-sel" id="langSel" title="Language">
            <option value="en">EN 🇬🇧</option>
            <option value="de">DE 🇩🇪</option>
            <option value="nl">NL 🇳🇱</option>
            <option value="pl">PL 🇵🇱</option>
          </select>
          <span style="cursor:pointer;color:rgba(255,255,255,0.85);font-size:18px;min-width:40px;
                       min-height:44px;display:inline-flex;align-items:center;justify-content:center"
                id="themeToggle" title="Theme">◐</span>
        </div>
      </div>
    </header>
    <div class="accent-bar accent-bar--trip"></div>

    <main class="main">

      <!-- ═══ No group yet ═══ -->
      <div id="noGroupView" style="display:none">
        <div class="empty-state" style="padding:24px 16px 12px">
          <div class="empty-icon">👥</div>
          <p class="empty-text" id="noGroupText"></p>
        </div>

        <div class="form-card">
          <p class="form-title" id="lblCreateGroup"></p>
          <div class="form-group">
            <input class="form-input" id="newGrpName" type="text" />
          </div>
          <button class="btn btn-primary btn-block" id="createGrpBtn"></button>
        </div>

        <div class="form-card">
          <p class="form-title" id="lblJoinGroup"></p>
          <div class="form-group">
            <input class="form-input" id="joinGrpName" type="text" />
          </div>
          <button class="btn btn-primary btn-block" id="joinGrpBtn"></button>
          <p style="font-size:12px;color:var(--ink-soft);margin-top:8px" id="joinStatus"></p>
        </div>
      </div>

      <!-- ═══ Group + trips ═══ -->
      <div id="groupView" style="display:none">

        <!-- Upcoming reminders banner -->
        <div id="reminderWrap"></div>

        <!-- Group info card -->
        <div class="form-card" style="border-left:4px solid var(--trip)">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <div>
              <div style="font-size:16px;font-weight:700">👥 <span id="grpName"></span></div>
              <div style="font-size:12px;color:var(--ink-soft);margin-top:4px" id="grpMembers"></div>
            </div>
          </div>
          <div id="pendingWrap" style="margin-top:12px"></div>
          <!-- Invite link strip (shown to all members) -->
          <div class="invite-strip" id="inviteStrip" style="display:none">
            <span id="inviteUrlDisplay"></span>
            <button id="copyInviteBtn"></button>
          </div>
          <div class="action-row" id="grpActionRow" style="display:none">
            <button class="pill-btn" id="exportAllBtn"></button>
          </div>
        </div>

        <!-- New trip form -->
        <div class="form-card">
          <p class="form-title" id="lblNewTrip"></p>
          <div class="form-group">
            <input class="form-input" id="tripName" type="text" />
          </div>
          <div class="form-group">
            <input class="form-input" id="tripDest" type="text" />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" id="lblFrom"></label>
              <input class="form-input" id="tripStart" type="date" />
            </div>
            <div class="form-group">
              <label class="form-label" id="lblTo"></label>
              <input class="form-input" id="tripEnd" type="date" />
            </div>
          </div>
          <div class="form-group">
            <textarea class="form-textarea" id="tripNotes" rows="2"></textarea>
          </div>
          <button class="btn btn-primary btn-block" id="addTripBtn"></button>
        </div>

        <h2 class="section-title" id="lblGroupTrips"></h2>
        <div id="tripList"><div class="spinner"><i class="dot"></i><i class="dot"></i><i class="dot"></i></div></div>

      </div>

      <!-- ═══ Trip detail ═══ -->
      <div id="detailView" style="display:none">
        <div id="tripInfoCard" class="form-card" style="border-left:4px solid var(--trip)"></div>

        <!-- Per-day itinerary -->
        <div class="form-card" id="itinSection">
          <p class="form-title" id="lblItinSection"></p>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" id="lblItinDate"></label>
              <input class="form-input" id="itinDate" type="date" />
            </div>
            <div class="form-group">
              <label class="form-label" id="lblItinTime"></label>
              <input class="form-input" id="itinTime" type="time" />
            </div>
          </div>
          <div class="form-group">
            <input class="form-input" id="itinTitle" type="text" />
          </div>
          <div class="form-group">
            <textarea class="form-textarea" id="itinNotes" rows="2"></textarea>
          </div>
          <button class="btn btn-primary btn-block" id="addItinBtn"></button>
          <div id="itinList" style="margin-top:14px"></div>
        </div>

        <!-- Custom plan section -->
        <div class="form-card" id="planSection">
          <p class="form-title" id="lblPlanSection"></p>
          <div id="planLinkDisplay"></div>
          <div id="planLinkEdit" style="display:none">
            <div class="plan-tabs">
              <button class="plan-tab active" data-pane="paste" id="tabPaste"></button>
              <button class="plan-tab" data-pane="upload" id="tabUpload"></button>
              <button class="plan-tab" data-pane="url" id="tabUrl"></button>
            </div>
            <div class="plan-pane active" data-pane="paste">
              <textarea class="form-textarea" id="planHtmlInput" rows="5"
                        style="font-family:monospace;font-size:12px"></textarea>
            </div>
            <div class="plan-pane" data-pane="upload">
              <label class="file-drop" id="fileDrop">
                <span id="fileDropText"></span>
                <input type="file" id="planFileInput" accept=".html,.htm,text/html" hidden />
              </label>
              <p id="fileChosen" style="font-size:12px;color:var(--trip-deep);margin-top:8px;display:none"></p>
            </div>
            <div class="plan-pane" data-pane="url">
              <input class="form-input" id="planUrlInput" type="url" />
            </div>
            <div style="display:flex;gap:8px;margin-top:12px">
              <button class="btn btn-primary" id="savePlanBtn"></button>
              <button class="btn btn-secondary" id="cancelPlanBtn"></button>
            </div>
          </div>
        </div>

        <div class="form-card">
          <p class="form-title" id="lblActivity"></p>
          <div class="form-row">
            <div class="form-group">
              <input class="form-input" id="actName" type="text" />
            </div>
            <div class="form-group">
              <input class="form-input" id="actDate" type="date" />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" id="lblAssigned"></label>
            <select class="form-select" id="actWho"></select>
          </div>
          <button class="btn btn-primary btn-block" id="addActBtn"></button>
        </div>

        <h2 class="section-title" id="lblActivities"></h2>
        <div id="actList"><div class="spinner"><i class="dot"></i><i class="dot"></i><i class="dot"></i></div></div>

        <button class="btn btn-danger" id="deleteTripBtn"
                style="width:100%;padding:12px;margin-top:20px"></button>
      </div>

    </main>

    <footer class="tvz-footer">
      <img src="../icons/TvZ_Logo.svg" alt="TvZ" />
    </footer>
  </div>

  <!-- ═══ Plan viewer modal ═══ -->
  <div id="planModal">
    <div class="plan-bar">
      <button class="btn btn-secondary" style="padding:6px 12px;flex-shrink:0"
              id="planModalClose">←</button>
      <span class="plan-bar-title" id="planModalTitle"></span>
      <a id="planModalFullBtn" href="#" target="_blank" rel="noopener"
         style="font-size:13px;white-space:nowrap;flex-shrink:0"></a>
    </div>
    <iframe id="planFrame"
            sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
  </div>

  <script type="module">
    import { db, requireAuth, wireOfflineBanner, escHtml } from '../firebase-config.js';
    import {
      doc, getDoc, getDocs, setDoc, updateDoc, deleteDoc,
      collection, addDoc, onSnapshot, serverTimestamp,
      query, where, orderBy, arrayUnion, arrayRemove
    } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

    /* ════════════════════════════════════════════════════════════
       i18n — four languages
    ════════════════════════════════════════════════════════════ */
    const I18N = {
      en: {
        title: 'Planner',
        offline: '✈️ Offline – syncing later',
        back: 'Back',
        allTrips: 'All trips',
        noGroup: "You're not in a group yet.\nCreate one or join an existing group.",
        createGroup: 'Create a group',
        grpNamePlaceholder: 'Group name, e.g. van Zanten',
        createGrpBtn: "Create group (you'll be admin)",
        joinGroup: 'Join existing group',
        joinNamePlaceholder: 'Exact group name',
        joinBtn: 'Send request',
        newTrip: 'New trip',
        tripNamePlaceholder: 'Trip name, e.g. Summer Holidays 2026',
        destPlaceholder: 'Destination, e.g. Croatia',
        from: 'From', to: 'To',
        notesPlaceholder: 'Notes…',
        addTripBtn: '+ Add trip',
        groupTrips: 'Group trips',
        activity: 'Activity / Task',
        actPlaceholder: 'e.g. Book accommodation',
        assigned: 'Assigned to (optional)',
        nobody: '— nobody —',
        addAct: '+ Add',
        activities: 'Activities',
        deleteTrip: '🗑 Delete trip',
        confirmDeleteTrip: 'Delete trip and all activities?',
        confirmDeleteAct: 'Delete activity?',
        admins: 'Admins',
        makeAdmin: 'Make admin',
        removeAdmin: 'Remove',
