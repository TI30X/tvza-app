    function randomToken(len = 22) {
      const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
      return Array.from(crypto.getRandomValues(new Uint8Array(len)))
        .map(b => chars[b % chars.length]).join('');
    }
