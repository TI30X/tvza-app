    /* ════════════════════════════════════════════════════════════
       Calendar helpers
    ════════════════════════════════════════════════════════════ */
    function toCalDate(s) { return (s || '').replace(/-/g, ''); }

    function gcalUrl(trip) {
      const start = toCalDate(trip.startDate);
      const end = toCalDate(trip.endDate) || start;
      const url = new URL('https://calendar.google.com/calendar/r/eventedit');
      url.searchParams.set('text', trip.name);
      if (start) url.searchParams.set('dates', `${start}/${end}`);
      if (trip.destination) url.searchParams.set('location', trip.destination);
      if (trip.notes) url.searchParams.set('details', trip.notes);
      return url.toString();
    }

    function icsEvent(trip) {
      const today = new Date().toISOString().slice(0, 10).replace(/-/g, '');
      const dtStart = toCalDate(trip.startDate) || today;
      const dtEnd = toCalDate(trip.endDate) || dtStart;
      const esc = s => (s || '').replace(/\\/g, '\\\\').replace(/;/g, '\\;').replace(/,/g, '\\,').replace(/\n/g, '\\n');
      return [
        'BEGIN:VEVENT',
        `UID:${trip.id}@tvza-planner`,
        `DTSTART;VALUE=DATE:${dtStart}`,
        `DTEND;VALUE=DATE:${dtEnd}`,
        `SUMMARY:${esc(trip.name)}`,
        trip.destination ? `LOCATION:${esc(trip.destination)}` : null,
        trip.notes ? `DESCRIPTION:${esc(trip.notes)}` : null,
        'END:VEVENT'
      ].filter(Boolean).join('\r\n');
    }

    function downloadIcsFile(events, filename) {
      const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//TVZA Planner//EN',
        ...events, 'END:VCALENDAR'].join('\r\n');
      const blob = new Blob([lines], { type: 'text/calendar;charset=utf-8' });
      const a = Object.assign(document.createElement('a'), {
        href: URL.createObjectURL(blob), download: filename
      });
      document.body.appendChild(a); a.click();
      setTimeout(() => { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
    }
    function downloadIcs(trip) {
      downloadIcsFile([icsEvent(trip)], `${trip.name.replace(/[^a-z0-9_-]/gi, '_')}.ics`);
    }

