          return;
        }
        await updateDoc(userRef, { familyId: null });
        myProfile.familyId = null;
      }
      showNoGroup();
    }

    async function handleInviteLink() {
      try {
        const snap = await getDoc(doc(grpCol, inviteGrpId));
        if (!snap.exists()) return false;
        const data = snap.data();
        if ((data.members || []).includes(user.uid)) {
          history.replaceState({}, '', location.pathname);
          await updateDoc(userRef, { familyId: inviteGrpId });
          watchGroup(inviteGrpId);
          return true;
        }
        if (data.inviteToken && data.inviteToken === inviteToken) {
          await updateDoc(doc(grpCol, inviteGrpId), { members: arrayUnion(user.uid) });
          await updateDoc(userRef, { familyId: inviteGrpId, role: 'member' });
          history.replaceState({}, '', location.pathname);
          watchGroup(inviteGrpId);
          const status = document.getElementById('joinStatus');
          if (status) status.textContent = t('autoJoined').replace('{name}', data.name || '');
          return true;
        }
      } catch (e) { console.warn('Invite link error:', e); }
      return false;
    }

    /* ════════════════════════════════════════════════════════════
       No-group view
    ════════════════════════════════════════════════════════════ */
    function showNoGroup() {
      showView(document.getElementById('noGroupView'));
      document.getElementById('groupView').style.display = 'none';
      checkPending();
    }
    async function checkPending() {
      const qs = await getDocs(query(grpCol, where('pendingRequests', 'array-contains', user.uid)));
      if (!qs.empty) {
        const f = qs.docs[0].data();
        document.getElementById('joinStatus').textContent =
          t('requestPending').replace('{name}', f.name || '');
      }
    }

    /* ════════════════════════════════════════════════════════════
       Create group / join request
    ════════════════════════════════════════════════════════════ */
    document.getElementById('createGrpBtn').addEventListener('click', async () => {
      const name = document.getElementById('newGrpName').value.trim();
      if (!name) { alert(t('pleaseGrpName')); return; }
      const existing = await getDocs(query(grpCol, where('name', '==', name)));
      if (!existing.empty) { alert(t('nameExists')); return; }
      const invToken = randomToken();
      const ref = await addDoc(grpCol, {
        name, headUid: user.uid, managers: [user.uid], members: [user.uid],
        pendingRequests: [], inviteToken: invToken, createdAt: serverTimestamp()
      });
      await updateDoc(userRef, { familyId: ref.id, role: 'manager' });
      myProfile.familyId = ref.id;
      document.getElementById('noGroupView').style.display = 'none';
      watchGroup(ref.id);
    });

    document.getElementById('joinGrpBtn').addEventListener('click', async () => {
      const name = document.getElementById('joinGrpName').value.trim();
      if (!name) { alert(t('pleaseGrpName')); return; }
      const qs = await getDocs(query(grpCol, where('name', '==', name)));
      if (qs.empty) { alert(t('grpNotFound')); return; }
      const grpDoc = qs.docs[0];
      const data = grpDoc.data();
      if ((data.members || []).includes(user.uid)) { alert(t('alreadyMember')); return; }
      if ((data.pendingRequests || []).includes(user.uid)) { alert(t('requestAlreadySent')); return; }
      await updateDoc(doc(grpCol, grpDoc.id), { pendingRequests: arrayUnion(user.uid) });
      document.getElementById('joinStatus').textContent =
        t('requestPending').replace('{name}', data.name || '');
    });

    /* ════════════════════════════════════════════════════════════
       Watch group (real-time)
    ════════════════════════════════════════════════════════════ */
    function watchGroup(grpId) {
      showView(document.getElementById('groupView'));
      document.getElementById('noGroupView').style.display = 'none';
      if (unsubGrp) unsubGrp();

      unsubGrp = onSnapshot(doc(grpCol, grpId), async snap => {
        if (!snap.exists()) { location.reload(); return; }
        group = { id: snap.id, ...snap.data() };

        if (!(group.managers?.length) && group.headUid) {
          group.managers = [group.headUid];
          updateDoc(doc(grpCol, grpId), { managers: group.managers }).catch(console.warn);
        }
        if (!(group.members || []).includes(user.uid)) {
          await updateDoc(userRef, { familyId: null });
          location.reload(); return;
        }

        document.getElementById('grpName').textContent = group.name;
        await loadMemberNames();
        renderMembers();
        renderAdminPanel();
        renderInviteStrip();
        refreshWhoSelect();
      });

      watchTrips(grpId);

      if (directTripId) {
        setTimeout(() => {
          if (cachedTrips.find(tr => tr.id === directTripId)) {
            openTrip(directTripId);
            history.replaceState({}, '', location.pathname);
          }
        }, 1500);
      }
    }

    async function loadMemberNames() {
      const uids = [...new Set([...(group.members || []), ...(group.pendingRequests || [])])];
      for (const uid of uids) {
        if (memberNames[uid]) continue;
        try {
          const s = await getDoc(doc(db, 'users', uid));
          memberNames[uid] = s.exists() ? s.data().displayName : '?';
        } catch { memberNames[uid] = '?'; }
      }
    }

    function grpManagers() {
      return [...new Set([...(group?.managers || []), group?.headUid].filter(Boolean))];
    }
    function isManager() { return grpManagers().includes(user.uid); }

    function renderMembers() {
      const mgrs = grpManagers();
      document.getElementById('grpMembers').innerHTML =
        (group.members || []).map(uid => {
          const star = mgrs.includes(uid) ? '★ ' : '';
          return `${star}${escHtml(memberNames[uid] || '?')}`;
        }).join(' · ');
    }

    function renderAdminPanel() {
      const wrap = document.getElementById('pendingWrap');
      if (!isManager()) { wrap.innerHTML = ''; return; }
      const mgrs = grpManagers();
      const pending = group.pendingRequests || [];
      let html = '';

      if (pending.length) {
        html += `<div style="font-size:12px;font-weight:600;margin-bottom:6px">${t('joinRequests')}:</div>` +
          pending.map(uid => `
          <div class="pending-card">
            <span style="flex:1">👤 ${escHtml(memberNames[uid] || '?')}</span>
            <button class="btn btn-primary" style="padding:5px 10px" data-approve="${uid}">✓</button>
            <button class="btn btn-secondary" style="padding:5px 10px" data-reject="${uid}">${ICON_CLOSE}</button>
          </div>`).join('');
      }

      html += `<div style="font-size:12px;font-weight:600;margin:12px 0 6px">${t('admins')}</div>` +
        (group.members || []).map(uid => {
          const isMgr = mgrs.includes(uid);
          const last = isMgr && mgrs.length <= 1;
          return `
          <div class="pending-card">
            <span style="flex:1">${isMgr ? '★' : '👤'} ${escHtml(memberNames[uid] || '?')}</span>
            <button class="btn ${isMgr ? 'btn-secondary' : 'btn-primary'}" style="padding:5px 10px"
                    data-mgr="${uid}" data-ismgr="${isMgr ? '1' : ''}" ${last ? 'disabled' : ''}>
              ${isMgr ? t('removeAdmin') : t('makeAdmin')}
            </button>
          </div>`;
        }).join('');

      wrap.innerHTML = html;

      wrap.querySelectorAll('[data-approve]').forEach(b => b.addEventListener('click', async () => {
        const uid = b.dataset.approve;
        await updateDoc(doc(grpCol, group.id), { members: arrayUnion(uid), pendingRequests: arrayRemove(uid) });
        await updateDoc(doc(db, 'users', uid), { familyId: group.id, role: 'member' });
      }));
      wrap.querySelectorAll('[data-reject]').forEach(b => b.addEventListener('click', () =>
        updateDoc(doc(grpCol, group.id), { pendingRequests: arrayRemove(b.dataset.reject) })));
      wrap.querySelectorAll('[data-mgr]').forEach(b => b.addEventListener('click', async () => {
        const uid = b.dataset.mgr;
        const wasMgr = b.dataset.ismgr === '1';
        const next = wasMgr ? grpManagers().filter(id => id !== uid) : [...grpManagers(), uid];
        if (!next.length) { alert(t('minOneAdmin')); return; }
        await updateDoc(doc(grpCol, group.id), { managers: next, headUid: next[0] });
        await updateDoc(doc(db, 'users', uid), { role: wasMgr ? 'member' : 'manager' }).catch(console.warn);
      }));
    }

    /* Invite strip + export-all (visible to all members) */
    async function renderInviteStrip() {
      const strip = document.getElementById('inviteStrip');
      let token = group.inviteToken;
      if (!token) {
        token = randomToken();
        await updateDoc(doc(grpCol, group.id), { inviteToken: token }).catch(console.warn);
      }
      document.getElementById('inviteUrlDisplay').textContent = buildInviteUrl(group.id, token);
      strip.style.display = 'flex';
    }

    document.getElementById('copyInviteBtn').addEventListener('click', async () => {
      const token = group?.inviteToken;
      if (!token) return;
      await copyText(buildInviteUrl(group.id, token));
      flashBtn(document.getElementById('copyInviteBtn'), t('linkCopied'));
    });

    document.getElementById('exportAllBtn').addEventListener('click', () => {
      const dated = cachedTrips.filter(tr => tr.startDate);
      if (!dated.length) return;
      downloadIcsFile(dated.map(icsEvent), `${(group?.name || 'planner').replace(/[^a-z0-9_-]/gi, '_')}_trips.ics`);
    });

    /* ════════════════════════════════════════════════════════════
       Reminders banner — upcoming trips within next 30 days
    ════════════════════════════════════════════════════════════ */
    function dayDiff(dateStr) {
      const d = new Date(dateStr + 'T00:00:00');
      const now = new Date(); now.setHours(0, 0, 0, 0);
      return Math.round((d - now) / 86400000);
    }
    function whenLabel(diff) {
      if (diff === 0) return t('today');
      if (diff === 1) return t('tomorrow');
      if (diff < 0)   return t('daysAgo');
      return t('inDays').replace('{n}', diff);
    }
    function renderReminders() {
      const wrap = document.getElementById('reminderWrap');
      if (!wrap) return;
      if (sessionStorage.getItem('tvza.remindersDismissed') === '1') { wrap.innerHTML = ''; return; }
      const soon = cachedTrips
        .filter(tr => tr.startDate)
        .map(tr => ({ tr, diff: dayDiff(tr.startDate) }))
        .filter(x => x.diff >= 0 && x.diff <= 30)
        .sort((a, b) => a.diff - b.diff);
      if (!soon.length) { wrap.innerHTML = ''; return; }

      wrap.innerHTML = `
        <div class="reminder-card">
          <button class="reminder-close" id="dismissReminders" title="Dismiss">✕</button>
          <div class="reminder-head"><span class="reminder-bell">🔔</span> ${t('upcoming')}</div>
          ${soon.slice(0, 4).map((x, i) => `
            <div class="reminder-item" style="animation-delay:${i * 60}ms" data-rem-trip="${x.tr.id}">
              <span>✈️ ${escHtml(x.tr.name)}${x.tr.destination ? ' · 📍 ' + escHtml(x.tr.destination) : ''}</span>
              <span class="when">${whenLabel(x.diff)}</span>
            </div>`).join('')}
        </div>`;
      document.getElementById('dismissReminders').addEventListener('click', () => {
        sessionStorage.setItem('tvza.remindersDismissed', '1');
        wrap.innerHTML = '';
      });
      wrap.querySelectorAll('[data-rem-trip]').forEach(el =>
        el.addEventListener('click', () => openTrip(el.dataset.remTrip)));
    }

    /* ════════════════════════════════════════════════════════════
       Trips (list)
    ════════════════════════════════════════════════════════════ */
    function watchTrips(grpId) {
      if (unsubTrips) unsubTrips();
      unsubTrips = onSnapshot(
        query(collection(db, 'trips'), where('familyId', '==', grpId), orderBy('createdAt', 'desc')),
        snap => {
          cachedTrips = snap.docs.map(d => ({ id: d.id, ...d.data() }));
          renderTrips(cachedTrips);
          renderReminders();
        });
    }

    function renderTrips(trips) {
      const wrap = document.getElementById('tripList');
      document.getElementById('grpActionRow').style.display =
        trips.some(tr => tr.startDate) ? 'flex' : 'none';

      if (!trips.length) {
        wrap.innerHTML = `<div class="empty-state">
          <div class="empty-icon">${ICON_MAP}</div>
          <p class="empty-text">${t('noTrips')}</p></div>`;
        return;
      }

      wrap.innerHTML = trips.map((trip, i) => {
        const hasDates = !!trip.startDate;
        const hasPlan = !!(trip.planUrl || trip.planHtml);
        const itinCount = (trip.itinerary || []).length;
        return `
        <div class="trip-card" data-trip="${trip.id}" style="cursor:pointer;--i:${i}">
          <div class="trip-name">${escHtml(trip.name)}</div>
          <div class="trip-meta">
            📍 ${escHtml(trip.destination || '–')}
            ${hasDates ? ` · 📅 ${trip.startDate}${trip.endDate ? ' – ' + trip.endDate : ''}` : ''}
            ${itinCount ? ` · 🗓 ${itinCount}` : ''}
          </div>
          ${trip.notes ? `<div class="trip-meta" style="margin-top:4px">📝 ${escHtml(trip.notes)}</div>` : ''}
          <div class="action-row">
            ${hasPlan ? `<button class="pill-btn pill-btn--primary" data-view-plan="${trip.id}">${t('viewPlan')}</button>` : ''}
            ${hasDates
              ? `<button class="pill-btn" data-gcal="${trip.id}">${t('gcal')}</button>
                 <button class="pill-btn" data-ics="${trip.id}">${t('icsDownload')}</button>`
              : ''}
            <button class="pill-btn" data-share-trip="${trip.id}">${t('shareTrip')}</button>
          </div>
        </div>`;
      }).join('');

      wrap.querySelectorAll('[data-trip]').forEach(card =>
        card.addEventListener('click', e => {
          if (e.target.closest('button')) return;
          openTrip(card.dataset.trip);
        }));
      wrap.querySelectorAll('[data-view-plan]').forEach(btn =>
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const trip = cachedTrips.find(tr => tr.id === btn.dataset.viewPlan);
          if (trip) openPlanModal(trip);
        }));
      wrap.querySelectorAll('[data-gcal]').forEach(btn =>
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const trip = cachedTrips.find(tr => tr.id === btn.dataset.gcal);
          if (trip) window.open(gcalUrl(trip), '_blank', 'noopener');
        }));
      wrap.querySelectorAll('[data-ics]').forEach(btn =>
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const trip = cachedTrips.find(tr => tr.id === btn.dataset.ics);
          if (trip) downloadIcs(trip);
        }));
      wrap.querySelectorAll('[data-share-trip]').forEach(btn =>
        btn.addEventListener('click', async e => {
          e.stopPropagation();
          await copyText(buildTripUrl(btn.dataset.shareTrip));
          flashBtn(btn, t('tripLinkCopied'));
        }));
    }

    document.getElementById('addTripBtn').addEventListener('click', async () => {
      const name = document.getElementById('tripName').value.trim();
      if (!name) { alert(t('tripNameRequired')); return; }
      await addDoc(collection(db, 'trips'), {
        familyId: group.id, name,
        destination: document.getElementById('tripDest').value.trim(),
        startDate: document.getElementById('tripStart').value,
        endDate: document.getElementById('tripEnd').value,
        notes: document.getElementById('tripNotes').value.trim(),
        itinerary: [],
        createdBy: user.uid, createdAt: serverTimestamp()
      });
      ['tripName', 'tripDest', 'tripStart', 'tripEnd', 'tripNotes']
        .forEach(id => document.getElementById(id).value = '');
    });

    /* ════════════════════════════════════════════════════════════
       Trip detail
    ════════════════════════════════════════════════════════════ */
    function refreshWhoSelect() {
      const sel = document.getElementById('actWho');
      const cur = sel.value;
      sel.innerHTML = `<option value="">${t('nobody')}</option>` +
        (group.members || []).map(uid =>
          `<option value="${uid}">${escHtml(memberNames[uid] || '?')}</option>`).join('');
      sel.value = cur;
    }

    function renderTripInfoCard(trip) {
      const hasDates = !!trip.startDate;
      document.getElementById('tripInfoCard').innerHTML = `
        <div style="font-size:18px;font-weight:700;margin-bottom:6px">${escHtml(trip.name)}</div>
        <div style="font-size:13px;color:var(--ink-soft)">
          📍 ${escHtml(trip.destination || '–')}
          ${hasDates ? ` · 📅 ${trip.startDate}${trip.endDate ? ' – ' + trip.endDate : ''}` : ''}
        </div>
        ${trip.notes ? `<div style="font-size:13px;margin-top:8px;color:var(--ink-soft)">📝 ${escHtml(trip.notes)}</div>` : ''}
        <div class="action-row" style="margin-top:12px">
          ${hasDates
            ? `<button class="pill-btn" id="detailGcalBtn">${t('gcal')}</button>
               <button class="pill-btn" id="detailIcsBtn">${t('icsDownload')}</button>`
            : ''}
          <button class="pill-btn" id="detailShareBtn">${t('shareTrip')}</button>
        </div>`;

      if (hasDates) {
        document.getElementById('detailGcalBtn').addEventListener('click', () => window.open(gcalUrl(trip), '_blank', 'noopener'));
        document.getElementById('detailIcsBtn').addEventListener('click', () => downloadIcs(trip));
      }
      document.getElementById('detailShareBtn').addEventListener('click', async () => {
        await copyText(buildTripUrl(trip.id));
        flashBtn(document.getElementById('detailShareBtn'), t('tripLinkCopied'));
      });
    }

    async function openTrip(tripId) {
      currentTripId = tripId;
      document.getElementById('groupView').style.display = 'none';
      showView(document.getElementById('detailView'));
      window.scrollTo({ top: 0, behavior: 'smooth' });

      const back = document.getElementById('backBtn');
      document.getElementById('backLabel').textContent = t('allTrips');
      back.removeAttribute('href');
      back.onclick = closeTrip;

      const ts = await getDoc(doc(db, 'trips', tripId));
      if (ts.exists()) {
        currentTripData = { id: ts.id, ...ts.data() };
        document.getElementById('pageTitle').textContent = currentTripData.name;
        renderTripInfoCard(currentTripData);
        renderPlanSection(currentTripData);
        renderItinerary(currentTripData.itinerary || []);
      }

      if (unsubActs) unsubActs();
      unsubActs = onSnapshot(
        query(collection(db, 'activities'), where('tripId', '==', tripId), orderBy('createdAt', 'asc')),
        snap => renderActs(snap.docs.map(d => ({ id: d.id, ...d.data() }))));
    }

    function closeTrip() {
      if (unsubActs) { unsubActs(); unsubActs = null; }
      currentTripId = null;
      currentTripData = null;
      document.getElementById('detailView').style.display = 'none';
      showView(document.getElementById('groupView'));
      document.getElementById('pageTitle').textContent = t('title');
      document.getElementById('backLabel').textContent = t('back');
      const back = document.getElementById('backBtn');
      back.onclick = null;
      back.href = '../index.html';
    }

    function renderActs(acts) {
      const wrap = document.getElementById('actList');
      if (!acts.length) {
        wrap.innerHTML = `<div class="empty-state">
          <div class="empty-icon">✅</div>
          <p class="empty-text">${t('noActivities')}</p></div>`;
        return;
      }
      wrap.innerHTML = '<div class="item-list">' + acts.map((a, i) => `
        <div class="item-card" style="--i:${i}">
          <div class="item-check ${a.done ? 'done' : ''}" data-toggle="${a.id}"
               data-done="${a.done}">${a.done ? '✓' : ''}</div>
          <div class="item-content">
            <div class="item-title ${a.done ? 'done' : ''}">${escHtml(a.name)}</div>
            <div class="item-sub">
              ${a.date ? '📅 ' + a.date : ''}
              ${a.assignedTo ? (a.date ? ' · ' : '') + '👤 ' + escHtml(memberNames[a.assignedTo] || '?') : ''}
            </div>
          </div>
          <div class="item-actions">
            <button class="btn btn-danger" data-del="${a.id}">${ICON_CLOSE}</button>
          </div>
        </div>`).join('') + '</div>';

      wrap.querySelectorAll('[data-toggle]').forEach(el =>
        el.addEventListener('click', () =>
          updateDoc(doc(db, 'activities', el.dataset.toggle), { done: el.dataset.done !== 'true' })));
      wrap.querySelectorAll('[data-del]').forEach(el =>
        el.addEventListener('click', () => {
          if (confirm(t('confirmDeleteAct'))) deleteDoc(doc(db, 'activities', el.dataset.del));
        }));
    }

    document.getElementById('addActBtn').addEventListener('click', async () => {
      if (!currentTripId) return;
      const name = document.getElementById('actName').value.trim();
      if (!name) { alert(t('actNameRequired')); return; }
      await addDoc(collection(db, 'activities'), {
        tripId: currentTripId, name,
        date: document.getElementById('actDate').value,
        assignedTo: document.getElementById('actWho').value || null,
        done: false, createdBy: user.uid, createdAt: serverTimestamp()
      });
      ['actName', 'actDate'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('actWho').value = '';
    });

    document.getElementById('deleteTripBtn').addEventListener('click', async () => {
      if (!currentTripId) return;
      if (!confirm(t('confirmDeleteTrip'))) return;
      const acts = await getDocs(query(collection(db, 'activities'), where('tripId', '==', currentTripId)));
      for (const a of acts.docs) await deleteDoc(a.ref);
      await deleteDoc(doc(db, 'trips', currentTripId));
      closeTrip();
    });

    /* ════════════════════════════════════════════════════════════
       Per-day itinerary
    ════════════════════════════════════════════════════════════ */
    function fmtDay(dateStr) {
      try {
        return new Date(dateStr + 'T00:00:00')
          .toLocaleDateString(LOCALE[langKey] || 'en-GB',
            { weekday: 'long', day: 'numeric', month: 'short' });
      } catch { return dateStr; }
    }

    function renderItinerary(items) {
      const wrap = document.getElementById('itinList');
      if (!items || !items.length) {
        wrap.innerHTML = `<div class="empty-state" style="padding:18px">
          <div class="empty-icon">🗓</div>
          <p class="empty-text">${t('noItinerary')}</p></div>`;
        return;
      }
      // group by date
      const byDay = {};
      items.forEach(it => { (byDay[it.date] = byDay[it.date] || []).push(it); });
      const days = Object.keys(byDay).sort();

      wrap.innerHTML = days.map((day, di) => {
        const rows = byDay[day]
          .sort((a, b) => (a.time || '').localeCompare(b.time || ''))
          .map((it, ii) => `
            <div class="itin-item" style="--ii:${ii}">
              <div class="itin-time">${it.time || '–'}</div>
              <div class="itin-body">
                <div class="itin-title">${escHtml(it.title)}</div>
                ${it.notes ? `<div class="itin-notes">${escHtml(it.notes)}</div>` : ''}
              </div>
              <button class="itin-del" data-del-itin="${it.id}" title="Delete">✕</button>
            </div>`).join('');
        return `<div class="itin-day" style="--d:${di}">
                  <div class="itin-day-head">🗓 ${fmtDay(day)}</div>
                  <div class="itin-line">${rows}</div>
                </div>`;
      }).join('');

      wrap.querySelectorAll('[data-del-itin]').forEach(btn =>
        btn.addEventListener('click', () => removeItin(btn.dataset.delItin)));
    }

    document.getElementById('addItinBtn').addEventListener('click', async () => {
      if (!currentTripId || !currentTripData) return;
      const date = document.getElementById('itinDate').value;
      const title = document.getElementById('itinTitle').value.trim();
      if (!date || !title) { alert(t('itinDateRequired')); return; }
      const item = {
        id: randomToken(10),
        date,
        time: document.getElementById('itinTime').value || '',
        title,
        notes: document.getElementById('itinNotes').value.trim()
      };
      const next = [...(currentTripData.itinerary || []), item];
      await updateDoc(doc(db, 'trips', currentTripId), { itinerary: next });
      currentTripData.itinerary = next;
      renderItinerary(next);
      renderTrips(cachedTrips);
      ['itinTitle', 'itinTime', 'itinNotes'].forEach(id => document.getElementById(id).value = '');
    });

    async function removeItin(itemId) {
      if (!currentTripId || !currentTripData) return;
      const next = (currentTripData.itinerary || []).filter(it => it.id !== itemId);
      await updateDoc(doc(db, 'trips', currentTripId), { itinerary: next });
      currentTripData.itinerary = next;
      renderItinerary(next);
      renderTrips(cachedTrips);
    }

    /* ════════════════════════════════════════════════════════════
       Plan section — paste HTML / upload file / link URL
    ════════════════════════════════════════════════════════════ */
    function renderPlanSection(trip) {
      const display = document.getElementById('planLinkDisplay');
      const editDiv = document.getElementById('planLinkEdit');
      editDiv.style.display = 'none';
      const hasUrl = !!trip?.planUrl;
      const hasHtml = !!trip?.planHtml;

      if (hasUrl || hasHtml) {
        const label = hasHtml
          ? t('planStored')
          : (trip.planUrl.length > 50 ? '…' + trip.planUrl.slice(-40) : trip.planUrl);
        display.innerHTML = `
          <div style="font-size:12px;color:var(--ink-soft);margin-bottom:8px">
            ${t('planLinked')} <em>${escHtml(label)}</em>
          </div>
          <div class="action-row">
            <button class="pill-btn pill-btn--primary" id="openPlanBtn">${t('viewPlan')}</button>
            <button class="pill-btn" id="editPlanBtn">${t('editPlan')}</button>
            <button class="pill-btn" id="removePlanBtn" style="color:var(--danger)">${t('removePlan')}</button>
          </div>`;
        display.style.display = '';

        document.getElementById('openPlanBtn').addEventListener('click', () => openPlanModal(trip));
        document.getElementById('editPlanBtn').addEventListener('click', () => openPlanEditor(trip));
        document.getElementById('removePlanBtn').addEventListener('click', async () => {
          if (!currentTripId) return;
          await updateDoc(doc(db, 'trips', currentTripId), { planUrl: '', planHtml: '' });
          if (currentTripData) { currentTripData.planUrl = ''; currentTripData.planHtml = ''; }
          renderPlanSection(currentTripData);
          renderTrips(cachedTrips);
        });
      } else {
        display.innerHTML = `<button class="pill-btn pill-btn--primary" id="linkPlanBtn">${t('linkPlan')}</button>`;
        display.style.display = '';
        document.getElementById('linkPlanBtn').addEventListener('click', () => openPlanEditor(trip));
      }
    }

    function openPlanEditor(trip) {
      planFileHtml = null;
      document.getElementById('planHtmlInput').value = trip?.planHtml || '';
      document.getElementById('planUrlInput').value = trip?.planUrl || '';
      document.getElementById('fileChosen').style.display = 'none';
      setPlanTab(trip?.planUrl && !trip?.planHtml ? 'url' : 'paste');
      document.getElementById('planLinkDisplay').style.display = 'none';
      document.getElementById('planLinkEdit').style.display = '';
    }

    function setPlanTab(pane) {
      document.querySelectorAll('.plan-tab').forEach(b => b.classList.toggle('active', b.dataset.pane === pane));
      document.querySelectorAll('.plan-pane').forEach(p => p.classList.toggle('active', p.dataset.pane === pane));
    }
    document.querySelectorAll('.plan-tab').forEach(b =>
      b.addEventListener('click', () => setPlanTab(b.dataset.pane)));

    // File upload / drop
    const fileDrop = document.getElementById('fileDrop');
    const planFileInput = document.getElementById('planFileInput');
    planFileInput.addEventListener('change', () => { if (planFileInput.files[0]) readPlanFile(planFileInput.files[0]); });
    ['dragenter', 'dragover'].forEach(ev => fileDrop.addEventListener(ev, e => { e.preventDefault(); fileDrop.classList.add('drag'); }));
    ['dragleave', 'drop'].forEach(ev => fileDrop.addEventListener(ev, e => { e.preventDefault(); fileDrop.classList.remove('drag'); }));
    fileDrop.addEventListener('drop', e => { const f = e.dataTransfer.files[0]; if (f) readPlanFile(f); });

    function readPlanFile(file) {
      const reader = new FileReader();
      reader.onload = () => {
        planFileHtml = reader.result;
        const chosen = document.getElementById('fileChosen');
        chosen.textContent = t('fileChosen').replace('{name}', file.name);
        chosen.style.display = '';
      };
      reader.readAsText(file);
    }

    document.getElementById('savePlanBtn').addEventListener('click', async () => {
      if (!currentTripId) return;
      const active = document.querySelector('.plan-tab.active')?.dataset.pane;
      let planHtml = '', planUrl = '';
      if (active === 'upload' && planFileHtml) planHtml = planFileHtml;
      else if (active === 'url') planUrl = document.getElementById('planUrlInput').value.trim();
      else planHtml = document.getElementById('planHtmlInput').value.trim();

      await updateDoc(doc(db, 'trips', currentTripId), { planHtml, planUrl });
      if (currentTripData) { currentTripData.planHtml = planHtml; currentTripData.planUrl = planUrl; }
      document.getElementById('planLinkEdit').style.display = 'none';
      renderPlanSection(currentTripData);
      renderTrips(cachedTrips);
    });

    document.getElementById('cancelPlanBtn').addEventListener('click', () => {
      document.getElementById('planLinkEdit').style.display = 'none';
      document.getElementById('planLinkDisplay').style.display = '';
    });

    // Plan viewer modal
    let planBlobUrl = null;
    function openPlanModal(trip) {
      const frame = document.getElementById('planFrame');
      const fullBtn = document.getElementById('planModalFullBtn');
      document.getElementById('planModalTitle').textContent = trip.name || '';
      if (planBlobUrl) { URL.revokeObjectURL(planBlobUrl); planBlobUrl = null; }

      if (trip.planHtml) {
        frame.removeAttribute('src');
        frame.srcdoc = trip.planHtml;
        planBlobUrl = URL.createObjectURL(new Blob([trip.planHtml], { type: 'text/html' }));
        fullBtn.href = planBlobUrl;
      } else {
        frame.removeAttribute('srcdoc');
        frame.src = trip.planUrl;
        fullBtn.href = trip.planUrl;
      }
      fullBtn.textContent = t('openFullScreen');
      document.getElementById('planModal').classList.add('visible');
    }
    document.getElementById('planModalClose').addEventListener('click', () => {
      const frame = document.getElementById('planFrame');
      document.getElementById('planModal').classList.remove('visible');
      frame.removeAttribute('src'); frame.removeAttribute('srcdoc');
      if (planBlobUrl) { URL.revokeObjectURL(planBlobUrl); planBlobUrl = null; }
    });

    /* ════════════════════════════════════════════════════════════
       Start
    ════════════════════════════════════════════════════════════ */
    init();
  </script>
</body>
</html>
