<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#1A1A2E" />
  <link rel="manifest" href="../manifest.json" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%230f3460'/><text x='16' y='22' font-family='Georgia,serif' font-size='13' font-weight='700' fill='white' text-anchor='middle'>TvZ</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;700&display=swap" />
  <script src="../theme.js"></script>
  <link rel="stylesheet" href="../style.css" />
  <title>Kalender — TVZA</title>
  <style>
    .cal-toolbar { display:flex; align-items:center; gap:8px; margin-bottom:14px; flex-wrap:wrap; }
    .cal-nav { display:flex; align-items:center; gap:4px; }
    .cal-title { font-size:18px; font-weight:700; min-width:150px; text-align:center; }
    .cal-icon-btn { width:38px; height:38px; display:inline-flex; align-items:center; justify-content:center;
      border:1px solid var(--border); border-radius:var(--r1); background:var(--surface); color:var(--ink);
      cursor:pointer; font-size:18px; line-height:1; }
    .cal-icon-btn:active { transform:scale(0.96); }
    .cal-spacer { flex:1; }
    .cal-pill { border:1px solid var(--border); background:var(--surface); color:var(--ink);
      border-radius:999px; padding:8px 14px; font-size:13px; font-weight:700; cursor:pointer; white-space:nowrap; }
    .cal-pill.primary { background:var(--accent); color:#fff; border-color:var(--accent); }
    .cal-weekdays { display:grid; grid-template-columns:repeat(7,1fr); gap:4px; margin-bottom:6px; }
    .cal-weekdays span { text-align:center; font-size:11px; font-weight:700; letter-spacing:.04em;
      color:var(--ink-soft); text-transform:uppercase; }
    .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:4px; }
    .cal-cell { position:relative; min-height:62px; border:1px solid var(--border); border-radius:10px;
      background:var(--surface); padding:5px 5px 4px; cursor:pointer; display:flex; flex-direction:column;
      transition:border-color .12s ease, background .12s ease; overflow:hidden; }
    .cal-cell:active { background:var(--surface-2); }
    .cal-cell.other { opacity:.4; }
    .cal-cell.today { border-color:var(--accent); border-width:2px; padding:4px 4px 3px; }
    .cal-daynum { font-size:13px; font-weight:700; color:var(--ink); }
    .cal-cell.today .cal-daynum { color:var(--accent); }
    .cal-dots { margin-top:auto; display:flex; flex-wrap:wrap; gap:3px; }
    .cal-dot { width:7px; height:7px; border-radius:50%; }
    .cal-chip { font-size:10px; line-height:1.25; border-radius:5px; padding:1px 4px; margin-top:2px;
      color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%; }
    .cal-more { font-size:9px; color:var(--ink-soft); margin-top:1px; }
    .cal-legend { display:flex; gap:14px; flex-wrap:wrap; margin-top:16px; font-size:12px; color:var(--ink-soft); }
    .cal-legend i { display:inline-block; width:9px; height:9px; border-radius:50%; margin-right:5px; vertical-align:1px; }

    /* Bottom sheet (day detail) + modals */
    .sheet-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.45); display:none; z-index:60; }
    .sheet-backdrop.visible { display:block; }
    .sheet { position:fixed; left:0; right:0; bottom:0; z-index:61; background:var(--surface);
      border-radius:18px 18px 0 0; box-shadow:0 -8px 30px rgba(0,0,0,.25); padding:18px 18px calc(20px + env(safe-area-inset-bottom));
      max-height:82vh; overflow:auto; transform:translateY(100%); transition:transform .3s cubic-bezier(.22,.61,.36,1);
      max-width:680px; margin:0 auto; }
    .sheet.visible { transform:translateY(0); }
    .sheet-grip { width:38px; height:4px; border-radius:2px; background:var(--border); margin:0 auto 12px; }
    .sheet-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:12px; }
    .sheet-date { font-size:17px; font-weight:700; }
    .ev { display:flex; align-items:flex-start; gap:11px; padding:12px; border:1px solid var(--border);
      border-radius:12px; margin-bottom:9px; background:var(--surface); }
    .ev-bar { width:4px; align-self:stretch; border-radius:3px; flex:0 0 auto; }
    .ev-body { flex:1; min-width:0; }
    .ev-title { font-size:15px; font-weight:700; }
    .ev-meta { font-size:12px; color:var(--ink-soft); margin-top:2px; }
    .ev-actions { display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }
    .ev-empty { color:var(--ink-soft); font-size:14px; text-align:center; padding:18px 0; }

    .field { margin-bottom:12px; }
    .field label { display:block; font-size:12px; font-weight:700; color:var(--ink-soft); margin-bottom:5px; }
    .swatches { display:flex; gap:9px; flex-wrap:wrap; }
    .swatch { width:30px; height:30px; border-radius:50%; cursor:pointer; border:3px solid transparent; }
    .swatch.sel { border-color:var(--ink); }
    .plan-tabs { display:flex; gap:6px; margin-bottom:8px; }
    .plan-tab { flex:1; font-family:inherit; font-size:12px; font-weight:700; padding:8px; border-radius:8px;
      border:1px solid var(--border); background:var(--surface); color:var(--ink-soft); cursor:pointer; }
    .plan-tab.active { background:var(--accent-bg); color:var(--accent); border-color:var(--accent); }
    .file-drop { display:flex; align-items:center; justify-content:center; padding:18px; border:2px dashed var(--border);
      border-radius:10px; color:var(--ink-soft); font-size:13px; cursor:pointer; text-align:center; }

    .viewer-backdrop { position:fixed; inset:0; background:var(--bg); display:none; z-index:80; flex-direction:column; }
    .viewer-backdrop.visible { display:flex; }
    .viewer-bar { display:flex; align-items:center; gap:10px; padding:12px 14px; border-bottom:1px solid var(--border); }
    .viewer-bar .v-title { flex:1; font-weight:700; font-size:15px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    #viewerFrame { flex:1; border:0; width:100%; background:#fff; }
  </style>
  <link rel="stylesheet" href="../ui-fx.css?v=10" />
  <script src="../ui-fx.js?v=10" defer></script>
</head>
<body>
  <div class="app">
    <div class="offline-banner" id="offlineBanner">✈️ Offline – Änderungen werden später synchronisiert</div>

    <header class="header">
      <div class="header-inner">
        <a href="../index.html" class="back-btn" aria-label="Zurück">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
          <span>Start</span>
        </a>
        <span class="page-title">Kalender</span>
        <span class="icon-btn" id="themeToggle" title="Theme">◐</span>
      </div>
    </header>

    <main class="main">
      <div class="cal-toolbar">
        <div class="cal-nav">
          <button class="cal-icon-btn" id="prevBtn" aria-label="Vorheriger Monat">‹</button>
          <span class="cal-title" id="calTitle">—</span>
          <button class="cal-icon-btn" id="nextBtn" aria-label="Nächster Monat">›</button>
        </div>
        <button class="cal-pill" id="todayBtn">Heute</button>
        <span class="cal-spacer"></span>
        <button class="cal-pill" id="googleBtn">🔗 Google</button>
        <button class="cal-pill primary" id="addDayBtn">+ Tag</button>
      </div>

      <div class="cal-weekdays"><span>Mo</span><span>Di</span><span>Mi</span><span>Do</span><span>Fr</span><span>Sa</span><span>So</span></div>
      <div class="cal-grid" id="grid"><div class="spinner" style="grid-column:1/-1">Lade…</div></div>

      <div class="cal-legend">
        <span><i style="background:#7f77dd"></i>Besondere Tage</span>
        <span><i style="background:#d8761d"></i>Reisen</span>
        <span><i style="background:#2f6fed"></i>Google</span>
      </div>

      <p style="margin-top:18px;font-size:13px;color:var(--ink-soft)">
        Reisen &amp; Gruppen findest du weiterhin im
        <a href="planner-trips.html" style="color:var(--accent);font-weight:700">Reiseplaner →</a>
      </p>
    </main>
  </div>

  <!-- Day detail sheet -->
  <div class="sheet-backdrop" id="sheetBackdrop"></div>
  <div class="sheet" id="daySheet">
    <div class="sheet-grip"></div>
    <div class="sheet-head">
      <span class="sheet-date" id="sheetDate">—</span>
      <button class="cal-pill primary" id="sheetAddBtn">+ Besonderer Tag</button>
    </div>
    <div id="sheetEvents"></div>
  </div>

  <!-- Special day form -->
  <div class="sheet-backdrop" id="formBackdrop"></div>
  <div class="sheet" id="dayForm">
    <div class="sheet-grip"></div>
    <div class="sheet-head">
      <span class="sheet-date" id="formTitle">Besonderer Tag</span>
      <button class="cal-icon-btn" id="formClose">✕</button>
    </div>
    <div class="field">
      <label for="fTitle">Titel</label>
      <input class="form-input" id="fTitle" type="text" placeholder="z.B. Geburtstag, Skitag, Konzert…" />
    </div>
    <div class="field">
      <label for="fDate">Datum</label>
      <input class="form-input" id="fDate" type="date" />
    </div>
    <div class="field">
      <label>Farbe</label>
      <div class="swatches" id="swatches"></div>
    </div>
    <div class="field">
      <label>Info-Seite (optional) — eigene HTML-Datei mit allen Infos</label>
      <div class="plan-tabs">
        <button class="plan-tab active" data-pane="paste">HTML einfügen</button>
        <button class="plan-tab" data-pane="upload">Datei</button>
        <button class="plan-tab" data-pane="url">Link</button>
      </div>
      <div data-pane-body="paste">
        <textarea class="form-textarea" id="fHtml" rows="5" placeholder="Deinen HTML-Code hier einfügen…"></textarea>
      </div>
      <div data-pane-body="upload" style="display:none">
        <label class="file-drop" id="fileDrop">
          <span id="fileDropText">HTML-Datei wählen (.html)</span>
          <input type="file" id="fFile" accept=".html,.htm,text/html" hidden />
        </label>
        <p id="fileChosen" style="font-size:12px;color:var(--accent);margin-top:8px;display:none"></p>
      </div>
      <div data-pane-body="url" style="display:none">
        <input class="form-input" id="fUrl" type="url" placeholder="https://… Link zu einer HTML-Seite" />
      </div>
    </div>
    <div style="display:flex;gap:8px;margin-top:8px">
      <button class="btn btn-primary" id="formSave" style="flex:1">Speichern</button>
      <button class="btn btn-danger" id="formDelete" style="display:none">Löschen</button>
    </div>
  </div>

  <!-- HTML viewer -->
  <div class="viewer-backdrop" id="viewer">
    <div class="viewer-bar">
      <button class="cal-icon-btn" id="viewerClose">‹</button>
      <span class="v-title" id="viewerTitle">Info</span>
      <a id="viewerFull" href="#" target="_blank" rel="noopener" class="cal-pill" style="display:none">Neuer Tab ↗</a>
    </div>
    <iframe id="viewerFrame" sandbox="allow-same-origin allow-popups allow-scripts" referrerpolicy="no-referrer"></iframe>
  </div>

  <script type="module">
    import { auth, db, requireAuth, wireOfflineBanner, escHtml, getProfile } from '../firebase-config.js';
    import {
      collection, addDoc, getDocs, query, where, doc, updateDoc, deleteDoc, serverTimestamp
    } from 'https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js';

    /* ── Google Calendar live sync ──────────────────────────────
       Fill GOOGLE_CLIENT_ID after creating an OAuth Web client at
       console.cloud.google.com (enable Google Calendar API, add
       https://ti30x.github.io to Authorized JavaScript origins).   */
    const GOOGLE_CLIENT_ID = '';
    const GOOGLE_SCOPE = 'https://www.googleapis.com/auth/calendar.readonly';

    const COLORS = ['#7f77dd','#2f6fed','#1d9e75','#e24b4a','#d8761d','#d4537e','#1d9e9e','#888780'];
    const TRIP_COLOR = '#d8761d';
    const GCAL_COLOR = '#2f6fed';
    const MONTHS = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];

    const $ = id => document.getElementById(id);
    const pad = n => String(n).padStart(2,'0');
    const keyOf = (y,m,d) => `${y}-${pad(m+1)}-${pad(d)}`;
    const todayKey = (() => { const t = new Date(); return keyOf(t.getFullYear(), t.getMonth(), t.getDate()); })();

    let user, profile, familyId = null;
    let viewY, viewM;
    let specialDays = [];   // {id, date, title, color, planHtml, planUrl}
    let trips = [];         // {id, name, startDate, endDate, planHtml, planUrl}
    let googleEvents = [];  // {date, title}
    let editingId = null, chosenColor = COLORS[0], uploadedHtml = '', activePane = 'paste';

    init();

    async function init() {
      user = await requireAuth('../login.html');
      wireOfflineBanner();
      profile = await getProfile(user);
      familyId = profile.familyId || null;
      const now = new Date();
      viewY = now.getFullYear(); viewM = now.getMonth();
      buildSwatches();
      wireUI();
      await loadData();
      render();
    }

    async function loadData() {
      const tasks = [
        getDocs(query(collection(db, 'calendarDays'), where('ownerUid', '==', user.uid)))
          .then(s => { specialDays = s.docs.map(d => ({ id:d.id, ...d.data() })); })
          .catch(e => { console.warn('special days', e); specialDays = []; })
      ];
      if (familyId) {
        tasks.push(
          getDocs(query(collection(db, 'trips'), where('familyId', '==', familyId)))
            .then(s => { trips = s.docs.map(d => ({ id:d.id, ...d.data() })); })
            .catch(e => { console.warn('trips', e); trips = []; })
        );
      }
      await Promise.all(tasks);
    }

    /* ── Event map: dateKey -> [events] ── */
    function buildEventMap() {
      const map = {};
      const push = (k, ev) => { (map[k] = map[k] || []).push(ev); };
      specialDays.forEach(s => { if (s.date) push(s.date, { kind:'special', color:s.color || COLORS[0], title:s.title || 'Tag', ref:s }); });
      trips.forEach(tr => {
        if (!tr.startDate) return;
        const end = tr.endDate || tr.startDate;
        let d = new Date(tr.startDate + 'T00:00:00');
        const last = new Date(end + 'T00:00:00');
        let guard = 0;
        while (d <= last && guard++ < 400) {
          push(keyOf(d.getFullYear(), d.getMonth(), d.getDate()), { kind:'trip', color:TRIP_COLOR, title:tr.name || 'Reise', ref:tr });
          d.setDate(d.getDate() + 1);
        }
      });
      googleEvents.forEach(g => { if (g.date) push(g.date, { kind:'google', color:GCAL_COLOR, title:g.title || 'Termin', ref:g }); });
      return map;
    }

    /* ── Render month grid ── */
    function render() {
      $('calTitle').textContent = `${MONTHS[viewM]} ${viewY}`;
      const map = buildEventMap();
      const first = new Date(viewY, viewM, 1);
      const offset = (first.getDay() + 6) % 7;        // Monday-start
      const daysInMonth = new Date(viewY, viewM + 1, 0).getDate();
      const prevDays = new Date(viewY, viewM, 0).getDate();
      const grid = $('grid');
      grid.innerHTML = '';
      for (let i = 0; i < 42; i++) {
        const cell = document.createElement('div');
        cell.className = 'cal-cell';
        let y = viewY, m = viewM, dayNum;
        if (i < offset) { dayNum = prevDays - offset + 1 + i; m = viewM - 1; if (m < 0) { m = 11; y--; } cell.classList.add('other'); }
        else if (i >= offset + daysInMonth) { dayNum = i - offset - daysInMonth + 1; m = viewM + 1; if (m > 11) { m = 0; y++; } cell.classList.add('other'); }
        else { dayNum = i - offset + 1; }
        const k = keyOf(y, m, dayNum);
        if (k === todayKey) cell.classList.add('today');
        const evs = map[k] || [];
        let inner = `<span class="cal-daynum">${dayNum}</span>`;
        if (evs.length) {
          const first2 = evs.slice(0, 2).map(e =>
            `<span class="cal-chip" style="background:${e.color}">${escHtml(e.title)}</span>`).join('');
          const more = evs.length > 2 ? `<span class="cal-more">+${evs.length - 2}</span>` : '';
          inner += `<div style="margin-top:auto">${first2}${more}</div>`;
        }
        cell.innerHTML = inner;
        cell.addEventListener('click', () => openDay(k, y, m, dayNum));
        grid.appendChild(cell);
      }
    }

    /* ── Day detail sheet ── */
    let sheetKey = null;
    function openDay(k, y, m, d) {
      sheetKey = k;
      const map = buildEventMap();
      const evs = map[k] || [];
      const dateObj = new Date(y, m, d);
      const wd = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'][dateObj.getDay()];
      $('sheetDate').textContent = `${wd}, ${d}. ${MONTHS[m]}`;
      const box = $('sheetEvents');
      if (!evs.length) {
        box.innerHTML = `<p class="ev-empty">Keine Einträge an diesem Tag.</p>`;
      } else {
        box.innerHTML = evs.map((e, i) => {
          const hasPage = e.kind === 'special' && (e.ref.planHtml || e.ref.planUrl);
          const hasTripPage = e.kind === 'trip' && (e.ref.planHtml || e.ref.planUrl);
          const label = e.kind === 'trip' ? 'Reise' : e.kind === 'google' ? 'Google' : 'Besonderer Tag';
          let actions = '';
          if (hasPage || hasTripPage) actions += `<button class="cal-pill primary" data-open="${i}">Infos öffnen</button>`;
          if (e.kind === 'special') actions += `<button class="cal-pill" data-edit="${i}">Bearbeiten</button>`;
          if (e.kind === 'trip') actions += `<a class="cal-pill" href="planner-trips.html?trip=${escHtml(e.ref.id)}">Im Reiseplaner</a>`;
          return `<div class="ev"><div class="ev-bar" style="background:${e.color}"></div>
            <div class="ev-body"><div class="ev-title">${escHtml(e.title)}</div>
            <div class="ev-meta">${label}</div>
            ${actions ? `<div class="ev-actions">${actions}</div>` : ''}</div></div>`;
        }).join('');
        box.querySelectorAll('[data-open]').forEach(b => b.addEventListener('click', () => {
          const e = evs[+b.dataset.open]; openViewer(e.title, e.ref.planHtml, e.ref.planUrl);
        }));
        box.querySelectorAll('[data-edit]').forEach(b => b.addEventListener('click', () => {
          const e = evs[+b.dataset.edit]; closeSheet(); openForm(e.ref);
        }));
      }
      showSheet();
    }
    function showSheet() { $('sheetBackdrop').classList.add('visible'); $('daySheet').classList.add('visible'); }
    function closeSheet() { $('sheetBackdrop').classList.remove('visible'); $('daySheet').classList.remove('visible'); }

    /* ── Special day form ── */
    function buildSwatches() {
      $('swatches').innerHTML = COLORS.map(c =>
        `<span class="swatch" data-c="${c}" style="background:${c}"></span>`).join('');
      $('swatches').querySelectorAll('.swatch').forEach(s => s.addEventListener('click', () => {
        chosenColor = s.dataset.c; markSwatch();
      }));
    }
    function markSwatch() {
      $('swatches').querySelectorAll('.swatch').forEach(s => s.classList.toggle('sel', s.dataset.c === chosenColor));
    }
    function setPane(p) {
      activePane = p;
      document.querySelectorAll('.plan-tab').forEach(t => t.classList.toggle('active', t.dataset.pane === p));
      document.querySelectorAll('[data-pane-body]').forEach(b => b.style.display = b.dataset.paneBody === p ? '' : 'none');
    }
    function openForm(existing) {
      editingId = existing ? existing.id : null;
      chosenColor = existing ? (existing.color || COLORS[0]) : COLORS[0];
      uploadedHtml = '';
      $('formTitle').textContent = existing ? 'Tag bearbeiten' : 'Besonderer Tag';
      $('fTitle').value = existing ? (existing.title || '') : '';
      $('fDate').value = existing ? (existing.date || sheetKey || todayKey) : (sheetKey || todayKey);
      $('fHtml').value = existing ? (existing.planHtml || '') : '';
      $('fUrl').value = existing ? (existing.planUrl || '') : '';
      $('fileChosen').style.display = 'none';
      $('formDelete').style.display = existing ? '' : 'none';
      setPane(existing && existing.planUrl && !existing.planHtml ? 'url' : 'paste');
      markSwatch();
      $('formBackdrop').classList.add('visible'); $('dayForm').classList.add('visible');
    }
    function closeForm() { $('formBackdrop').classList.remove('visible'); $('dayForm').classList.remove('visible'); }

    async function saveForm() {
      const title = $('fTitle').value.trim();
      const date = $('fDate').value;
      if (!title) { alert('Bitte einen Titel eingeben.'); return; }
      if (!date) { alert('Bitte ein Datum wählen.'); return; }
      let planHtml = '', planUrl = '';
      if (activePane === 'upload' && uploadedHtml) planHtml = uploadedHtml;
      else if (activePane === 'url') planUrl = $('fUrl').value.trim();
      else planHtml = $('fHtml').value.trim();
      const data = { ownerUid: user.uid, title, date, color: chosenColor, planHtml, planUrl };
      $('formSave').disabled = true; $('formSave').textContent = 'Speichern…';
      try {
        if (editingId) await updateDoc(doc(db, 'calendarDays', editingId), data);
        else { data.createdAt = serverTimestamp(); await addDoc(collection(db, 'calendarDays'), data); }
        await loadData(); render(); closeForm();
      } catch (e) { console.warn(e); alert('Speichern fehlgeschlagen.'); }
      $('formSave').disabled = false; $('formSave').textContent = 'Speichern';
    }
    async function deleteForm() {
      if (!editingId) return;
      if (!confirm('Diesen Tag löschen?')) return;
      try { await deleteDoc(doc(db, 'calendarDays', editingId)); await loadData(); render(); closeForm(); }
      catch (e) { console.warn(e); alert('Löschen fehlgeschlagen.'); }
    }

    /* ── HTML viewer ── */
    function openViewer(title, html, url) {
      $('viewerTitle').textContent = title || 'Info';
      const frame = $('viewerFrame');
      const full = $('viewerFull');
      if (url) { frame.removeAttribute('srcdoc'); frame.src = url; full.href = url; full.style.display = ''; }
      else { frame.removeAttribute('src'); frame.srcdoc = html || '<p style="font-family:sans-serif;padding:24px">Keine Infos hinterlegt.</p>'; full.style.display = 'none'; }
      $('viewer').classList.add('visible');
    }
    function closeViewer() {
      $('viewer').classList.remove('visible');
      const frame = $('viewerFrame'); frame.removeAttribute('src'); frame.removeAttribute('srcdoc');
    }

    /* ── Google Calendar (Phase B) ── */
    function connectGoogle() {
      if (!GOOGLE_CLIENT_ID) {
        alert('Google-Sync ist noch nicht eingerichtet. Sobald die OAuth-Client-ID hinterlegt ist, kannst du hier deinen Google-Kalender verbinden.');
        return;
      }
      loadGapiAndAuth();
    }
    function loadGapiAndAuth() {
      const start = () => {
        google.accounts.oauth2.initTokenClient({
          client_id: GOOGLE_CLIENT_ID, scope: GOOGLE_SCOPE,
          callback: async (resp) => {
            if (resp && resp.access_token) await fetchGoogleEvents(resp.access_token);
          }
        }).requestAccessToken();
      };
      if (window.google && google.accounts && google.accounts.oauth2) { start(); return; }
      const s = document.createElement('script');
      s.src = 'https://accounts.google.com/gsi/client'; s.async = true; s.defer = true;
      s.onload = start; document.head.appendChild(s);
    }
    async function fetchGoogleEvents(token) {
      try {
        const timeMin = new Date(viewY, viewM - 1, 1).toISOString();
        const timeMax = new Date(viewY, viewM + 2, 0).toISOString();
        const url = `https://www.googleapis.com/calendar/v3/calendars/primary/events?singleEvents=true&orderBy=startTime&timeMin=${encodeURIComponent(timeMin)}&timeMax=${encodeURIComponent(timeMax)}&maxResults=250`;
        const r = await fetch(url, { headers: { Authorization: 'Bearer ' + token } });
        const data = await r.json();
        googleEvents = (data.items || []).map(it => {
          const start = (it.start && (it.start.date || it.start.dateTime)) || '';
          return { date: start.slice(0, 10), title: it.summary || '(ohne Titel)' };
        }).filter(e => e.date);
        render();
      } catch (e) { console.warn('google fetch', e); alert('Google-Termine konnten nicht geladen werden.'); }
    }

    /* ── Wiring ── */
    function wireUI() {
      $('prevBtn').addEventListener('click', () => { viewM--; if (viewM < 0) { viewM = 11; viewY--; } render(); });
      $('nextBtn').addEventListener('click', () => { viewM++; if (viewM > 11) { viewM = 0; viewY++; } render(); });
      $('todayBtn').addEventListener('click', () => { const n = new Date(); viewY = n.getFullYear(); viewM = n.getMonth(); render(); });
      $('addDayBtn').addEventListener('click', () => { sheetKey = todayKey; openForm(null); });
      $('sheetAddBtn').addEventListener('click', () => { closeSheet(); openForm(null); });
      $('googleBtn').addEventListener('click', connectGoogle);
      $('sheetBackdrop').addEventListener('click', closeSheet);
      $('formBackdrop').addEventListener('click', closeForm);
      $('formClose').addEventListener('click', closeForm);
      $('formSave').addEventListener('click', saveForm);
      $('formDelete').addEventListener('click', deleteForm);
      $('viewerClose').addEventListener('click', closeViewer);
      document.querySelectorAll('.plan-tab').forEach(t => t.addEventListener('click', () => setPane(t.dataset.pane)));
      $('fFile').addEventListener('change', (e) => {
        const f = e.target.files[0]; if (!f) return;
        const reader = new FileReader();
        reader.onload = () => { uploadedHtml = String(reader.result || ''); $('fileChosen').textContent = '✓ ' + f.name; $('fileChosen').style.display = ''; };
        reader.readAsText(f);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        if ($('viewer').classList.contains('visible')) closeViewer();
        else if ($('dayForm').classList.contains('visible')) closeForm();
        else if ($('daySheet').classList.contains('visible')) closeSheet();
      });
    }
  </script>
</body>
