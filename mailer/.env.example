# Firebase Admin (the JSON file itself must never be committed)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=tvza-11d44

# Provider-neutral SMTP settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=TVZA <noreply@example.com>

# Public URL containing login.html
APP_BASE_URL=https://example.com/tvza/

# Worker tuning
MAIL_COLLECTION=mail
POLL_INTERVAL_MS=30000
BATCH_SIZE=25
MAX_RETRIES=5
RETRY_BASE_MS=60000
LEASE_MS=300000
