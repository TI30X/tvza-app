rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isGuest() {
      return signedIn()
        && exists(/databases/$(database)/documents/guestProfiles/$(request.auth.uid));
    }

    function emailVerified() {
      return authHasEmail()
        && request.auth.token.email_verified == true;
    }

    function requireEmailVerification() {
      return exists(/databases/$(database)/documents/config/tvza)
        && 'requireEmailVerification' in get(
          /databases/$(database)/documents/config/tvza
        ).data
        && get(
          /databases/$(database)/documents/config/tvza
        ).data.requireEmailVerification == true;
    }

    function emailVerificationAllowed() {
      return !requireEmailVerification() || emailVerified();
    }

    // A Firebase login alone is not membership. Meaningful app access needs
    // a users/{uid} profile and, only when configured, a verified email.
    function isMember() {
      return hasProfile() && !isGuest() && emailVerificationAllowed();
    }

    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTimo == true;
    }

    function authHasEmail() {
      return signedIn() && 'email' in request.auth.token;
    }

    function inviteIsValid(data) {
      return authHasEmail()
        && (
          (data.inviteCode == null && data.familyId == null)
          || (
            data.inviteCode is string
            && exists(/databases/$(database)/documents/memberInvites/$(data.inviteCode))
            && get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.email
              == request.auth.token.email.lower()
            && (
              (
                (
                  !('familyId' in get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data)
                  || get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.familyId == null
                )
                && data.familyId == null
              )
              || (
                get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.familyId is string
                && data.familyId
                  == get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.familyId
                && existsAfter(/databases/$(database)/documents/families/$(data.familyId))
                && request.auth.uid in getAfter(
                  /databases/$(database)/documents/families/$(data.familyId)
                ).data.members
              )
            )
            && !existsAfter(
              /databases/$(database)/documents/memberInvites/$(data.inviteCode)
            )
          )
        );
    }

    // ── Calendar group membership ───────────────────────────────
    // Belonging to the family app is NOT the same as belonging to a calendar
    // group. Each group document carries its own members list, and all group
    // data — trips, activities, attachments — is gated on that list.

    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function familyExists(familyId) {
      return familyId is string
        && exists(/databases/$(database)/documents/families/$(familyId));
    }

    function inFamily(familyId) {
      return isMember()
        && familyExists(familyId)
        && request.auth.uid in familyData(familyId).get('members', []);
    }

    function managesFamily(familyId) {
      return isMember()
        && familyExists(familyId)
        && (
          familyData(familyId).get('headUid', '') == request.auth.uid
          || request.auth.uid in familyData(familyId).get('managers', [])
        );
    }

    // The same two checks against the document already being read or written,
    // so the rules on /families itself need no extra lookup.
    function inFamilyDoc() {
      return isMember() && request.auth.uid in resource.data.get('members', []);
    }

    function managesFamilyDoc() {
      return isMember()
        && (
          resource.data.get('headUid', '') == request.auth.uid
          || request.auth.uid in resource.data.get('managers', [])
        );
    }

    /* ── Gruppen ───────────────────────────────────────────────────
       Ein Objekt fuer Familie und Kader. Der Unterschied zwischen
       beiden sind Woerter und eingeschaltete Bereiche, nicht Code.

       Mitglieder liegen als Unterdokumente unter der Gruppe, nicht als
       Array auf dem Gruppendokument. Das ist der ganze Grund fuer diese
       Phase: ein Array kann keine Rolle pro Person tragen, und genau die
       braucht ein Kader — Haupttrainer, Trainer, Athlet. Ausserdem
       waechst ein Array bis an die Dokumentgrenze, waehrend eine
       Untersammlung nicht endet.

       Drei Rollen, in beiden Gruppenarten dieselben:
         head    — Haupttrainer / Kopf der Familie. Genau einer.
         staff   — weitere Trainer / Eltern. Kuratieren, aber uebergeben nicht.
         mitglied — Athlet / Kind.

       Kosten: jede Pruefung hier ist genau ein Lesezugriff. Firestore
       erlaubt zehn pro Anfrage, wir bleiben also weit darunter. */

    function inGroup(gid) {
      return isMember()
        && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function groupRole(gid) {
      return get(
        /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)
      ).data.get('rolle', '');
    }

    // Kopf und Trainer kuratieren dasselbe. Nur der Kopf uebergibt,
    // loescht und vergibt Rollen.
    function leadsGroup(gid) {
      return inGroup(gid) && groupRole(gid) in ['head', 'staff'];
    }

    function headsGroup(gid) {
      return isMember()
        && exists(/databases/$(database)/documents/groups/$(gid))
        && get(/databases/$(database)/documents/groups/$(gid))
          .data.get('headUid', '') == request.auth.uid;
    }

    function canUseTrip(tripId) {
      return tripId is string
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && inFamily(
          get(/databases/$(database)/documents/trips/$(tripId)).data.get('familyId', '')
        );
    }

    // An attachment hangs off either a group trip or a personal calendar day.
    function canUseAttachmentParent(parentId) {
      return parentId is string
        && (
          canUseTrip(parentId)
          || (
            exists(/databases/$(database)/documents/calendarDays/$(parentId))
            && get(/databases/$(database)/documents/calendarDays/$(parentId)).data.ownerUid
              == request.auth.uid
          )
        );
    }

    function registrationInviteCode() {
      return getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.inviteCode;
    }

    function invitedAutoJoin(familyId) {
      return authHasEmail()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && registrationInviteCode() is string
        && exists(/databases/$(database)/documents/memberInvites/$(registrationInviteCode()))
        && get(/databases/$(database)/documents/memberInvites/$(registrationInviteCode())).data.email
          == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/memberInvites/$(registrationInviteCode())).data.familyId
          == familyId
        && !existsAfter(
          /databases/$(database)/documents/memberInvites/$(registrationInviteCode())
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && !(request.auth.uid in resource.data.get('members', []))
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.get('members', []))
        && request.resource.data.members.size()
          == resource.data.get('members', []).size() + 1;
    }

    function consumesInvite(code) {
      return authHasEmail()
        && resource.data.email == request.auth.token.email.lower()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode
          == code
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
          == request.auth.token.email.lower()
        && (
          (
            (!('familyId' in resource.data) || resource.data.familyId == null)
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId
              == null
          )
          || (
            resource.data.familyId is string
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId
              == resource.data.familyId
            && existsAfter(/databases/$(database)/documents/families/$(resource.data.familyId))
            && request.auth.uid in getAfter(
              /databases/$(database)/documents/families/$(resource.data.familyId)
            ).data.members
          )
        );
    }

    function shareId(ownerUid, targetUid, moduleKey) {
      return ownerUid + '__' + targetUid + '__' + moduleKey;
    }

    function hasModuleShare(ownerUid, moduleKey) {
      return isMember()
        && exists(/databases/$(database)/documents/shares/$(shareId(ownerUid, request.auth.uid, moduleKey)));
    }

    function canEditModule(ownerUid, moduleKey) {
      return hasModuleShare(ownerUid, moduleKey)
        && get(/databases/$(database)/documents/shares/$(shareId(ownerUid, request.auth.uid, moduleKey))).data.role == 'edit';
    }

    function isLegacyParentOf(ownerUid) {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isParent == true
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)).data.isTimo == true;
    }

    function hasGuestAccess(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/guestAccess/$(request.auth.uid + '_' + tripId));
    }

    // ── Family membership and invitations ───────────────────────
    match /memberInvites/{code} {
      allow get: if isAdmin()
                 || (
                   authHasEmail()
                   && resource.data.email == request.auth.token.email.lower()
                 )
                 || (
                   isMember()
                   && resource.data.createdBy == request.auth.uid
                 );
      allow list: if isAdmin()
                  || (
                    isMember()
                    && resource.data.createdBy == request.auth.uid
                  );
      allow create: if isMember()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email
                      == request.resource.data.email.lower()
                    && request.resource.data.keys().hasOnly([
                      'email', 'familyId', 'createdBy', 'createdAt'
                    ])
                    && (
                      (
                        request.resource.data.familyId == null
                        && isAdmin()
                      )
                      || (
                        request.resource.data.familyId is string
                        && managesFamily(request.resource.data.familyId)
                      )
                    );
      allow update: if false;
      allow delete: if isAdmin()
                    || (
                      isMember()
                      && resource.data.createdBy == request.auth.uid
                      && resource.data.familyId is string
                      && managesFamily(resource.data.familyId)
                    )
                    || consumesInvite(code);
    }

    match /mail/{mailId} {
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly([
                      'to', 'template', 'createdAt'
                    ])
                    && request.resource.data.to is list
                    && request.resource.data.to.size() == 1
                    && request.resource.data.template is map
                    && request.resource.data.template.keys().hasOnly(['name', 'data'])
                    && request.resource.data.template.name == 'member-invite'
                    && request.resource.data.template.data is map
                    && request.resource.data.template.data.keys().hasOnly([
                      'inviteCode', 'familyName'
                    ])
                    && request.resource.data.template.data.inviteCode is string
                    && request.resource.data.template.data.familyName is string
                    && mailId == (
                      'member-invite-'
                      + request.resource.data.template.data.inviteCode
                    )
                    && existsAfter(
                      /databases/$(database)/documents/memberInvites/$(
                        request.resource.data.template.data.inviteCode
                      )
                    )
                    && getAfter(
                      /databases/$(database)/documents/memberInvites/$(
                        request.resource.data.template.data.inviteCode
                      )
                    ).data.createdBy == request.auth.uid
                    && request.resource.data.to[0] == getAfter(
                      /databases/$(database)/documents/memberInvites/$(
                        request.resource.data.template.data.inviteCode
                      )
                    ).data.email;
      allow read, update, delete: if false;
    }

    match /users/{uid} {
      // A guest may check whether their own family profile exists. Listing
      // profiles remains family-only.
      allow get: if signedIn() && request.auth.uid == uid || isMember();
      allow list: if isMember();

      // A profile may be created without an invite. A supplied invite is
      // email-bound, consumed atomically and, if linked, joins one family.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && inviteIsValid(request.resource.data)
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.role == 'member'
                    && request.resource.data.isTimo == false
                    && request.resource.data.keys().hasOnly([
                      'displayName', 'email', 'familyId', 'role', 'isTimo',
                      'allowedModules', 'modules', 'createdAt', 'inviteCode'
                    ]);

      // Members may change only their own preferences and planner membership.
      // Admin/module flags and the account email are server-controlled. A
      // self-set familyId must be a group the user really belongs to,
      // otherwise the join-approval flow could be skipped by writing here.
      allow update: if isAdmin()
                    || (
                      isMember()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'modules', 'projectsSeeded', 'familyId', 'role'])
                      && (
                        request.resource.data.get('familyId', null)
                          == resource.data.get('familyId', null)
                        || request.resource.data.get('familyId', null) == null
                        || inFamily(request.resource.data.familyId)
                      )
                    )
                    || (
                      isMember()
                      && request.auth.uid != uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['familyId', 'role'])
                      && managesFamily(request.resource.data.familyId)
                    );
      allow delete: if isAdmin();
    }

    match /users/{uid}/reminders/{reminderId} {
      allow read, create, update, delete: if isMember()
                                           && request.auth.uid == uid;
    }

    // Trainingsbereich: das eingelesene Wochenprogramm liegt als
    // JSON-Zeichenkette, weil Firestore keine Arrays in Arrays kennt und
    // die Originaltabellen genau das sind. Die Grenze hält ein einzelnes
    // Dokument klein genug (Firestore erlaubt 1 MiB).
    match /users/{uid}/trainingPrograms/{programId} {
      allow read, delete: if isMember()
                           && request.auth.uid == uid;
      allow create, update: if isMember()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly([
                              'schema', 'id', 'json', 'updatedAt'
                            ])
                            && request.resource.data.schema == 1
                            && request.resource.data.json is string
                            && request.resource.data.json.size() <= 900000;
    }

    // Ein Dokument je Trainingstag. units hält die Einheiten des Tages;
    // die Grenze verhindert, dass ein Fehler im Client ein Dokument
    // unbegrenzt wachsen lässt.
    match /users/{uid}/trainingLogs/{trainingDate} {
      allow read, delete: if isMember()
                           && request.auth.uid == uid;
      allow create, update: if isMember()
                            && request.auth.uid == uid
                            && trainingDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
                            && request.resource.data.keys().hasOnly([
                              'schema', 'units', 'updatedAt'
                            ])
                            && request.resource.data.schema == 1
                            && request.resource.data.units is map
                            && request.resource.data.units.size() <= 20;
    }

    match /users/{uid}/maturaProgress/{progressId} {
      allow read, delete: if isMember()
                           && request.auth.uid == uid;
      allow create, update: if isMember()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly([
                              'state', 'schema', 'updatedAt'
                            ])
                            && request.resource.data.state is map
                            && request.resource.data.state.size() <= 100
                            && request.resource.data.schema == 1;
    }

    // ── Guests ───────────────────────────────────────────────────
    match /guestProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && !exists(/databases/$(database)/documents/users/$(uid))
                    && !exists(/databases/$(database)/documents/guestProfiles/$(uid))
                    && request.resource.data.keys().hasOnly([
                      'email', 'name', 'createdAt', 'lastActiveAt'
                    ]);
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['name', 'lastActiveAt']);
      allow delete: if isMember()
                    || (signedIn() && request.auth.uid == uid
                        && exists(/databases/$(database)/documents/users/$(uid)));
    }

    match /guestAccess/{docId} {
      allow get: if signedIn()
                 && (isMember() || docId.split('_')[0] == request.auth.uid);
      allow list: if isMember();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && docId == (request.resource.data.uid + '_' + request.resource.data.tripId)
                    && request.resource.data.keys().hasOnly([
                      'uid', 'tripId', 'token', 'createdAt'
                    ])
                    && exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId))
                    && request.resource.data.token
                      == get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.guestToken;
      allow update: if false;
      allow delete: if isMember();
    }

    match /tripViews/{viewId} {
      allow read: if isMember();
      allow create: if signedIn()
                    && isGuest()
                    && request.resource.data.guestUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'tripId', 'guestUid', 'viewedAt'
                    ])
                    && hasGuestAccess(request.resource.data.tripId);
      allow update, delete: if false;
    }

    // ── Direct messages ──────────────────────────────────────────
    match /dms/{convId} {
      allow read: if signedIn()
                  && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants[0]
                      != request.resource.data.participants[1]
                    && convId == (
                      request.resource.data.participants[0] + '__'
                      + request.resource.data.participants[1]
                    );
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'participantNames', 'lastMessage', 'lastAt', 'lastSender',
                        'unread', 'lastRead', 'typing'
                      ]);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
                    && request.auth.uid in get(
                      /databases/$(database)/documents/dms/$(convId)
                    ).data.participants;
        allow create: if signedIn()
                      && request.auth.uid == request.resource.data.sender
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.keys().hasOnly([
                        'text', 'sender', 'createdAt'
                      ])
                      && request.auth.uid in get(
                        /databases/$(database)/documents/dms/$(convId)
                      ).data.participants;
        allow update, delete: if false;
      }
    }

    // ── Public project feed ──────────────────────────────────────
    // Public means public. No password or secret URL is stored here.
    match /publicProjects/{docId} {
      allow read: if true;
      allow create: if isMember()
                    && request.auth.uid == request.resource.data.ownerUid
                    && docId.split('__')[0] == request.auth.uid
                    && request.resource.data.url is string
                    && request.resource.data.url.lower().matches('https?://.*')
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'emoji', 'name', 'url', 'updatedAt'
                    ]);
      allow update: if isMember()
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && docId.split('__')[0] == request.auth.uid
                    && request.resource.data.url is string
                    && request.resource.data.url.lower().matches('https?://.*')
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'emoji', 'name', 'url', 'updatedAt'
                    ]);
      allow delete: if isMember()
                    && request.auth.uid == resource.data.ownerUid;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Module sharing ───────────────────────────────────────────
    // Canonical id: <ownerUid>__<targetUid>__<module>.
    match /shares/{id} {
      allow read: if isMember()
                  && (
                    resource.data.ownerUid == request.auth.uid
                    || resource.data.targetUid == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isMember()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.targetUid != request.auth.uid
                    && id == shareId(
                      request.resource.data.ownerUid,
                      request.resource.data.targetUid,
                      request.resource.data.module
                    )
                    && request.resource.data.module in ['ski', 'food', 'watch']
                    && request.resource.data.role in ['view', 'edit']
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'module', 'targetUid',
                      'targetEmail', 'targetName', 'role', 'createdAt'
                    ]);
      allow update: if isMember()
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.targetUid == resource.data.targetUid
                    && request.resource.data.module == resource.data.module
                    && id == shareId(
                      resource.data.ownerUid,
                      resource.data.targetUid,
                      resource.data.module
                    )
                    && request.resource.data.role in ['view', 'edit'];
      allow delete: if isMember()
                    && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    // ── Per-user data ────────────────────────────────────────────
    match /projects/{ownerUid}/{p=**} {
      allow read, write: if isMember() && request.auth.uid == ownerUid;
    }

    match /skitracker/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'ski')
                    || isLegacyParentOf(ownerUid)
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'ski')
                   );
    }

    match /foodlog/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'food')
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'food')
                   );
    }

    match /watchlist/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'watch')
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'watch')
                   );
    }

    // ── Shared family data ───────────────────────────────────────
    match /customFoods/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /foodRequests/{id} {
      allow read: if isAdmin()
                  || (
                    isMember()
                    && resource.data.requestedByEmail == request.auth.token.email.lower()
                  );
      allow create: if isMember()
                    && request.resource.data.requestedByEmail
                      == request.auth.token.email.lower();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /secrets/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    // ── Calendar groups ──────────────────────────────────────────
    // The group document holds the member list and the invite token, so only
    // its own members may read it. Searching for a group by name goes through
    // /familyDirectory, which carries nothing but the name.
    match /familyDirectory/{familyId} {
      allow read: if isMember();
      allow create, update: if managesFamily(familyId)
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 80
                            && request.resource.data.keys().hasOnly(['name']);
      allow delete: if managesFamily(familyId);
    }

    match /families/{id} {
      allow get, list: if inFamilyDoc() || managesFamilyDoc();

      allow create: if isMember()
                    && request.resource.data.headUid == request.auth.uid
                    && request.resource.data.members == [request.auth.uid]
                    && request.resource.data.managers == [request.auth.uid]
                    && request.resource.data.pendingRequests == []
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.inviteToken is string
                    && request.resource.data.inviteToken.size() >= 8
                    && request.resource.data.keys().hasOnly([
                      'name', 'headUid', 'managers', 'members', 'pendingRequests',
                      'inviteToken', 'calendarColor', 'createdAt'
                    ]);

      allow update: if
                    // Managers curate the group. Only the head may change the
                    // manager list or hand the lead over.
                    (
                      managesFamilyDoc()
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly([
                          'name', 'calendarColor', 'members', 'managers',
                          'headUid', 'pendingRequests', 'inviteToken'
                        ])
                      && request.resource.data.headUid is string
                      && request.auth.uid in request.resource.data.members
                      && (
                        request.resource.data.headUid == resource.data.headUid
                        || resource.data.get('headUid', '') == request.auth.uid
                      )
                      && (
                        request.resource.data.get('managers', [])
                          == resource.data.get('managers', [])
                        || resource.data.get('headUid', '') == request.auth.uid
                      )
                    )
                    // Registration with an email-bound group invitation adds
                    // only the new account and consumes the invite atomically.
                    || invitedAutoJoin(id)
                    // Joining through an invite link: the caller proves it knows
                    // the token by sending it back unchanged, and may add nobody
                    // but itself.
                    || (
                      isMember()
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['members', 'inviteToken'])
                      && resource.data.inviteToken is string
                      && resource.data.inviteToken.size() >= 8
                      && request.resource.data.inviteToken == resource.data.inviteToken
                      && !(request.auth.uid in resource.data.get('members', []))
                      && request.resource.data.members
                        == resource.data.get('members', []).concat([request.auth.uid])
                    )
                    // Asking to join: adds only itself to pendingRequests.
                    || (
                      isMember()
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['pendingRequests'])
                      && !(request.auth.uid in resource.data.get('members', []))
                      && request.resource.data.pendingRequests
                        == resource.data.get('pendingRequests', []).concat([request.auth.uid])
                    )
                    // Leaving: removes only itself. The head hands over first.
                    || (
                      isMember()
                      && request.auth.uid in resource.data.get('members', [])
                      && resource.data.get('headUid', '') != request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['members', 'managers'])
                      && request.resource.data.members
                        == resource.data.get('members', []).removeAll([request.auth.uid])
                      && request.resource.data.get('managers', [])
                        == resource.data.get('managers', []).removeAll([request.auth.uid])
                    );

      allow delete: if isMember()
                    && resource.data.get('headUid', '') == request.auth.uid;
    }

    match /groups/{gid} {
      allow get, list: if inGroup(gid);

      // Eine Gruppe entsteht nie ohne ihren Kopf. existsAfter prueft den
      // Zustand NACH dem Schreiben, das Mitgliedsdokument muss also im
      // selben Stapel liegen — beide entstehen zusammen oder gar nicht.
      // Ohne diese Klammer gaebe es kopflose Gruppen, die niemand mehr
      // verwalten oder loeschen kann.
      allow create: if isMember()
                    && request.resource.data.headUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.art in ['familie', 'kader']
                    && request.resource.data.bereiche is map
                    && request.resource.data.inviteToken is string
                    && request.resource.data.inviteToken.size() >= 8
                    && request.resource.data.keys().hasOnly([
                      'name', 'art', 'headUid', 'bereiche',
                      'inviteToken', 'farbe', 'createdAt'
                    ])
                    && existsAfter(
                      /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)
                    );

      allow update: if
                    // Kuratieren: Name, Farbe, eingeschaltete Bereiche und
                    // ein frischer Einladungscode. 'art' steht bewusst NICHT
                    // in dieser Liste — sie entscheidet ueber Wortwahl und
                    // Vorgaben, und ein Wechsel im Betrieb wuerde bestehende
                    // Termine und Rollen sinnlos machen.
                    (
                      leadsGroup(gid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name', 'farbe', 'bereiche', 'inviteToken'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 80
                      && request.resource.data.bereiche is map
                    )
                    // Uebergabe: nur der Kopf, und nur an jemanden, der
                    // bereits Mitglied ist.
                    || (
                      headsGroup(gid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['headUid'])
                      && request.resource.data.headUid is string
                      && exists(
                        /databases/$(database)/documents/groups/$(gid)/members/$(request.resource.data.headUid)
                      )
                    );

      allow delete: if headsGroup(gid);
    }

    match /groups/{gid}/members/{uid} {
      // Mitglieder sehen einander — ohne das gaebe es keine Kaderliste.
      allow get, list: if inGroup(gid);

      allow create: if isMember()
                    && request.resource.data.uid == uid
                    && request.resource.data.rolle is string
                    && request.resource.data.keys().hasOnly(['uid', 'rolle', 'seit'])
                    && (
                      // Der Gruender legt sich selbst als Kopf an. Erlaubt nur,
                      // wenn die Gruppe im selben Stapel ihn auch als Kopf
                      // fuehrt — sonst koennte sich jemand zum Kopf einer
                      // fremden Gruppe erklaeren, indem er einfach ein
                      // Mitgliedsdokument schreibt.
                      (
                        request.auth.uid == uid
                        && request.resource.data.rolle == 'head'
                        && getAfter(/databases/$(database)/documents/groups/$(gid))
                          .data.headUid == request.auth.uid
                      )
                      // Die Leitung nimmt jemanden auf, nie als zweiten Kopf.
                      || (
                        leadsGroup(gid)
                        && request.resource.data.rolle in ['staff', 'mitglied']
                      )
                    );

      // Rollen vergibt nur der Kopf — wie bei families, wo auch nur der
      // Kopf die Managerliste aendert. Duerfte die Leitung das, koennten
      // sich zwei Trainer gegenseitig herabstufen.
      allow update: if headsGroup(gid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['rolle'])
                    && request.resource.data.rolle in ['staff', 'mitglied']
                    && resource.data.get('rolle', '') != 'head';

      allow delete: if
                    // Selbst gehen. Der Kopf uebergibt vorher — sonst bliebe
                    // eine Gruppe ohne Kopf zurueck.
                    (
                      request.auth.uid == uid
                      && resource.data.get('rolle', '') != 'head'
                    )
                    // Die Leitung entfernt jemanden, aber nie den Kopf.
                    || (
                      leadsGroup(gid)
                      && resource.data.get('rolle', '') != 'head'
                    );
    }

    match /trips/{tripId} {
      allow get: if inFamily(resource.data.get('familyId', ''))
                 || hasGuestAccess(tripId);
      allow list: if inFamily(resource.data.get('familyId', ''));
      allow create: if inFamily(request.resource.data.get('familyId', ''))
                    && request.resource.data.createdBy == request.auth.uid;
      // Moving a trip is allowed only between groups the caller belongs to.
      allow update: if inFamily(resource.data.get('familyId', ''))
                    && inFamily(request.resource.data.get('familyId', ''))
                    && request.resource.data.get('createdBy', '')
                      == resource.data.get('createdBy', '');
      allow delete: if inFamily(resource.data.get('familyId', ''));
    }

    match /activities/{id} {
      allow read: if canUseTrip(resource.data.get('tripId', ''));
      allow create: if canUseTrip(request.resource.data.get('tripId', ''))
                    && request.resource.data.keys().hasOnly([
                      'tripId', 'name', 'done', 'createdAt'
                    ]);
      allow update: if canUseTrip(resource.data.get('tripId', ''))
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['name', 'done']);
      allow delete: if canUseTrip(resource.data.get('tripId', ''));
    }

    match /calendarDays/{id} {
      allow create: if isMember()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isMember()
                          && resource.data.ownerUid == request.auth.uid;
      allow update: if isMember()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }

    match /attachments/{id} {
      allow read: if canUseAttachmentParent(resource.data.get('parent', ''));
      allow create: if canUseAttachmentParent(request.resource.data.get('parent', ''))
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.size is number
                    && request.resource.data.size <= 950000
                    && request.resource.data.keys().hasOnly([
                      'parent', 'scope', 'name', 'type', 'size', 'dataUrl', 'by', 'at'
                    ]);
      allow update: if false;
      allow delete: if canUseAttachmentParent(resource.data.get('parent', ''));
    }

    // Everything else is denied by default.
  }
}
