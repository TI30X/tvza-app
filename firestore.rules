rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isGuest() {
      return signedIn()
        && exists(/databases/$(database)/documents/guestProfiles/$(request.auth.uid));
    }

    // A Firebase login alone is not membership. A member needs a users/{uid}
    // profile created through an admin invitation and must not be a guest.
    function isMember() {
      return hasProfile() && !isGuest();
    }

    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTimo == true;
    }

    function authHasEmail() {
      return signedIn() && 'email' in request.auth.token;
    }

    function inviteIsValid(data) {
      return authHasEmail()
        && data.inviteCode is string
        && exists(/databases/$(database)/documents/memberInvites/$(data.inviteCode))
        && get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.email
          == request.auth.token.email.lower();
    }

    function managesFamily(familyId) {
      return isMember()
        && familyId is string
        && exists(/databases/$(database)/documents/families/$(familyId))
        && (
          get(/databases/$(database)/documents/families/$(familyId)).data.headUid == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.managers
        );
    }

    function shareId(ownerUid, targetUid, moduleKey) {
      return ownerUid + '__' + targetUid + '__' + moduleKey;
    }

    function hasModuleShare(ownerUid, moduleKey) {
      return isMember()
        && exists(/databases/$(database)/documents/shares/$(shareId(ownerUid, request.auth.uid, moduleKey)));
    }

    function canEditModule(ownerUid, moduleKey) {
      return hasModuleShare(ownerUid, moduleKey)
        && get(/databases/$(database)/documents/shares/$(shareId(ownerUid, request.auth.uid, moduleKey))).data.role == 'edit';
    }

    function isLegacyParentOf(ownerUid) {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isParent == true
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)).data.isTimo == true;
    }

    function hasGuestAccess(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/guestAccess/$(request.auth.uid + '_' + tripId));
    }

    // ── Family membership and invitations ───────────────────────
    match /memberInvites/{code} {
      allow read, create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      // A guest may check whether their own family profile exists. Listing
      // profiles remains family-only.
      allow get: if signedIn() && request.auth.uid == uid || isMember();
      allow list: if isMember();

      // New family profiles require a high-entropy code created by an admin.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && inviteIsValid(request.resource.data)
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.role == 'member'
                    && request.resource.data.isTimo == false
                    && request.resource.data.familyId == null
                    && request.resource.data.keys().hasOnly([
                      'displayName', 'email', 'familyId', 'role', 'isTimo',
                      'allowedModules', 'modules', 'createdAt', 'inviteCode'
                    ]);

      // Members may change only their own preferences and planner membership.
      // Admin/module flags and the account email are server-controlled.
      allow update: if isAdmin()
                    || (
                      isMember()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'modules', 'projectsSeeded', 'familyId', 'role'])
                    )
                    || (
                      isMember()
                      && request.auth.uid != uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['familyId', 'role'])
                      && managesFamily(request.resource.data.familyId)
                    );
      allow delete: if isAdmin();
    }

    // ── Guests ───────────────────────────────────────────────────
    match /guestProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && !exists(/databases/$(database)/documents/users/$(uid))
                    && !exists(/databases/$(database)/documents/guestProfiles/$(uid))
                    && request.resource.data.keys().hasOnly([
                      'email', 'name', 'createdAt', 'lastActiveAt'
                    ]);
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['name', 'lastActiveAt']);
      allow delete: if isMember()
                    || (signedIn() && request.auth.uid == uid
                        && exists(/databases/$(database)/documents/users/$(uid)));
    }

    match /guestAccess/{docId} {
      allow get: if signedIn()
                 && (isMember() || docId.split('_')[0] == request.auth.uid);
      allow list: if isMember();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && docId == (request.resource.data.uid + '_' + request.resource.data.tripId)
                    && request.resource.data.keys().hasOnly([
                      'uid', 'tripId', 'token', 'createdAt'
                    ])
                    && exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId))
                    && request.resource.data.token
                      == get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.guestToken;
      allow update: if false;
      allow delete: if isMember();
    }

    match /tripViews/{viewId} {
      allow read: if isMember();
      allow create: if signedIn()
                    && isGuest()
                    && request.resource.data.guestUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'tripId', 'guestUid', 'viewedAt'
                    ])
                    && hasGuestAccess(request.resource.data.tripId);
      allow update, delete: if false;
    }

    // ── Direct messages ──────────────────────────────────────────
    match /dms/{convId} {
      allow read: if signedIn()
                  && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants[0]
                      != request.resource.data.participants[1]
                    && convId == (
                      request.resource.data.participants[0] + '__'
                      + request.resource.data.participants[1]
                    );
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'participantNames', 'lastMessage', 'lastAt', 'lastSender',
                        'unread', 'lastRead', 'typing'
                      ]);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
                    && request.auth.uid in get(
                      /databases/$(database)/documents/dms/$(convId)
                    ).data.participants;
        allow create: if signedIn()
                      && request.auth.uid == request.resource.data.sender
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.keys().hasOnly([
                        'text', 'sender', 'createdAt'
                      ])
                      && request.auth.uid in get(
                        /databases/$(database)/documents/dms/$(convId)
                      ).data.participants;
        allow update, delete: if false;
      }
    }

    // ── Public project feed ──────────────────────────────────────
    // Public means public. No password or secret URL is stored here.
    match /publicProjects/{docId} {
      allow read: if true;
      allow create: if isMember()
                    && request.auth.uid == request.resource.data.ownerUid
                    && docId.split('__')[0] == request.auth.uid
                    && request.resource.data.url is string
                    && request.resource.data.url.lower().matches('https?://.*')
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'emoji', 'name', 'url', 'updatedAt'
                    ]);
      allow update: if isMember()
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && docId.split('__')[0] == request.auth.uid
                    && request.resource.data.url is string
                    && request.resource.data.url.lower().matches('https?://.*')
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'emoji', 'name', 'url', 'updatedAt'
                    ]);
      allow delete: if isMember()
                    && request.auth.uid == resource.data.ownerUid;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Module sharing ───────────────────────────────────────────
    // Canonical id: <ownerUid>__<targetUid>__<module>.
    match /shares/{id} {
      allow read: if isMember()
                  && (
                    resource.data.ownerUid == request.auth.uid
                    || resource.data.targetUid == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isMember()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.targetUid != request.auth.uid
                    && id == shareId(
                      request.resource.data.ownerUid,
                      request.resource.data.targetUid,
                      request.resource.data.module
                    )
                    && request.resource.data.module in ['ski', 'food', 'watch']
                    && request.resource.data.role in ['view', 'edit']
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'module', 'targetUid',
                      'targetEmail', 'targetName', 'role', 'createdAt'
                    ]);
      allow update: if isMember()
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.targetUid == resource.data.targetUid
                    && request.resource.data.module == resource.data.module
                    && id == shareId(
                      resource.data.ownerUid,
                      resource.data.targetUid,
                      resource.data.module
                    )
                    && request.resource.data.role in ['view', 'edit'];
      allow delete: if isMember()
                    && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    // ── Per-user data ────────────────────────────────────────────
    match /projects/{ownerUid}/{p=**} {
      allow read, write: if isMember() && request.auth.uid == ownerUid;
    }

    match /skitracker/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'ski')
                    || isLegacyParentOf(ownerUid)
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'ski')
                   );
    }

    match /foodlog/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'food')
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'food')
                   );
    }

    match /watchlist/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'watch')
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'watch')
                   );
    }

    // ── Shared family data ───────────────────────────────────────
    match /customFoods/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /foodRequests/{id} {
      allow read: if isAdmin()
                  || (
                    isMember()
                    && resource.data.requestedByEmail == request.auth.token.email.lower()
                  );
      allow create: if isMember()
                    && request.resource.data.requestedByEmail
                      == request.auth.token.email.lower();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /secrets/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    match /families/{id}     { allow read, write: if isMember(); }
    match /activities/{id}   { allow read, write: if isMember(); }
    match /calendarDays/{id} { allow read, write: if isMember(); }
    match /attachments/{id}  { allow read, write: if isMember(); }

    match /trips/{tripId} {
      allow read: if isMember() || hasGuestAccess(tripId);
      allow write: if isMember();
    }

    // Everything else is denied by default.
  }
}
