rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // ── Direktnachrichten (PRIVAT) ──────────────────────────────
    // Nur die beiden Teilnehmer dürfen eine Unterhaltung + ihre
    // Nachrichten lesen/schreiben. convId = "<uidA>__<uidB>" (sortiert).
    match /dms/{convId} {
      allow read:   if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
                      && request.auth.uid in request.resource.data.participants
                      && request.resource.data.participants.size() == 2;
      allow update: if signedIn()
                      && request.auth.uid in resource.data.participants
                      && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        allow read:   if signedIn()
                        && request.auth.uid in get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        allow create: if signedIn()
                        && request.auth.uid == request.resource.data.sender
                        && request.auth.uid in get(/databases/$(database)/documents/dms/$(convId)).data.participants;
        allow update, delete: if false;
      }
    }

    // ── Gemeinsamer öffentlicher Projekt-Feed (flach) ──
    // Jeder darf lesen; nur der Eigentümer schreibt seine eigenen Einträge.
    match /publicProjects/{docId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if signedIn() && request.auth.uid == resource.data.ownerUid;
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;
    }

    // ── Config (timoUid) — öffentlich lesbar für public.html ──
    match /config/{docId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ── Freigaben (Module teilen) ──
    match /shares/{id} { allow read, write: if signedIn(); }

    // ── Übrige App-Daten: Familien-Vertrauensmodell ──
    // Alle ANGEMELDETEN Nutzer dürfen lesen/schreiben (wie bisher).
    // Diese Sammlungen sind bewusst einzeln aufgeführt, damit die
    // strikte dms-Regel oben NICHT von einer globalen Catch-all-Regel
    // ausgehebelt wird (Firestore gewährt Zugriff, sobald EINE Regel passt).
    match /users/{p=**}      { allow read, write: if signedIn(); }
    match /projects/{p=**}   { allow read, write: if signedIn(); }
    match /skitracker/{p=**} { allow read, write: if signedIn(); }
    match /foodlog/{p=**}    { allow read, write: if signedIn(); }
    match /watchlist/{p=**}  { allow read, write: if signedIn(); }
    match /customFoods/{id}  { allow read, write: if signedIn(); }
    match /foodRequests/{id} { allow read, write: if signedIn(); }
    match /families/{id}     { allow read, write: if signedIn(); }
    match /trips/{id}        { allow read, write: if signedIn(); }
    match /activities/{id}   { allow read, write: if signedIn(); }
    match /calendarDays/{id} { allow read, write: if signedIn(); }
    match /attachments/{id}  { allow read, write: if signedIn(); }

    // Alles andere ist standardmässig verweigert.
  }
}
