rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isGuest() {
      return signedIn()
        && exists(/databases/$(database)/documents/guestProfiles/$(request.auth.uid));
    }

    function emailVerified() {
      return authHasEmail()
        && request.auth.token.email_verified == true;
    }

    function requireEmailVerification() {
      return exists(/databases/$(database)/documents/config/tvza)
        && 'requireEmailVerification' in get(
          /databases/$(database)/documents/config/tvza
        ).data
        && get(
          /databases/$(database)/documents/config/tvza
        ).data.requireEmailVerification == true;
    }

    function emailVerificationAllowed() {
      return !requireEmailVerification() || emailVerified();
    }

    // A Firebase login alone is not membership. Meaningful app access needs
    // a users/{uid} profile and, only when configured, a verified email.
    function isMember() {
      return hasProfile() && !isGuest() && emailVerificationAllowed();
    }

    function isAdmin() {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isTimo == true;
    }

    function authHasEmail() {
      return signedIn() && 'email' in request.auth.token;
    }

    function inviteIsValid(data) {
      return authHasEmail()
        && (
          (data.inviteCode == null && data.familyId == null)
          || (
            data.inviteCode is string
            && exists(/databases/$(database)/documents/memberInvites/$(data.inviteCode))
            && get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.email
              == request.auth.token.email.lower()
            && (
              (
                (
                  !('familyId' in get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data)
                  || get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.familyId == null
                )
                && data.familyId == null
              )
              || (
                get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.familyId is string
                && data.familyId
                  == get(/databases/$(database)/documents/memberInvites/$(data.inviteCode)).data.familyId
                && existsAfter(/databases/$(database)/documents/families/$(data.familyId))
                && request.auth.uid in getAfter(
                  /databases/$(database)/documents/families/$(data.familyId)
                ).data.members
              )
            )
            && !existsAfter(
              /databases/$(database)/documents/memberInvites/$(data.inviteCode)
            )
          )
        );
    }

    // ── Calendar group membership ───────────────────────────────
    // Belonging to the family app is NOT the same as belonging to a calendar
    // group. Each group document carries its own members list, and all group
    // data — trips, activities, attachments — is gated on that list.

    function familyData(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    function familyExists(familyId) {
      return familyId is string
        && exists(/databases/$(database)/documents/families/$(familyId));
    }

    function inFamily(familyId) {
      return isMember()
        && familyExists(familyId)
        && request.auth.uid in familyData(familyId).get('members', []);
    }

    function managesFamily(familyId) {
      return isMember()
        && familyExists(familyId)
        && (
          familyData(familyId).get('headUid', '') == request.auth.uid
          || request.auth.uid in familyData(familyId).get('managers', [])
        );
    }

    // The same two checks against the document already being read or written,
    // so the rules on /families itself need no extra lookup.
    function inFamilyDoc() {
      return isMember() && request.auth.uid in resource.data.get('members', []);
    }

    function managesFamilyDoc() {
      return isMember()
        && (
          resource.data.get('headUid', '') == request.auth.uid
          || request.auth.uid in resource.data.get('managers', [])
        );
    }

    /* ── Gruppen ───────────────────────────────────────────────────
       Ein Objekt fuer Familie und Kader. Der Unterschied zwischen
       beiden sind Woerter und eingeschaltete Bereiche, nicht Code.

       Mitglieder liegen als Unterdokumente unter der Gruppe, nicht als
       Array auf dem Gruppendokument. Das ist der ganze Grund fuer diese
       Phase: ein Array kann keine Rolle pro Person tragen, und genau die
       braucht ein Kader — Haupttrainer, Trainer, Athlet. Ausserdem
       waechst ein Array bis an die Dokumentgrenze, waehrend eine
       Untersammlung nicht endet.

       Drei Rollen, in beiden Gruppenarten dieselben:
         head    — Haupttrainer / Kopf der Familie. Genau einer.
         staff   — weitere Trainer / Eltern. Kuratieren, aber uebergeben nicht.
         mitglied — Athlet / Kind.

       Kosten: jede Pruefung hier ist genau ein Lesezugriff. Firestore
       erlaubt zehn pro Anfrage, wir bleiben also weit darunter. */

    function inGroup(gid) {
      return isMember()
        && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function groupRole(gid) {
      return get(
        /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)
      ).data.get('rolle', '');
    }

    // Kopf und Trainer kuratieren dasselbe. Nur der Kopf uebergibt,
    // loescht und vergibt Rollen.
    function leadsGroup(gid) {
      return inGroup(gid) && groupRole(gid) in ['head', 'staff'];
    }

    function headsGroup(gid) {
      return isMember()
        && exists(/databases/$(database)/documents/groups/$(gid))
        && get(/databases/$(database)/documents/groups/$(gid))
          .data.get('headUid', '') == request.auth.uid;
    }

    /* Eine Reise gehoert einer Gruppe. trips.familyId heisst noch so, meint
       aber seit v.35.32.0 die Gruppe: eine uebernommene Familie traegt als
       Gruppe DIESELBE Kennung (groups/{familyId}), und eine Gruppe, die nie
       eine Familie war, schreibt ihre eigene Kennung hinein. Zugang hat, wer
       in der alten Familie steht ODER Mitglied der Gruppe ist — das Erste,
       damit nichts verschwindet, solange der Kopf noch nicht uebernommen
       hat. Dass niemand eine Gruppe mit der Kennung einer FREMDEN Familie
       anlegt und so an deren Reisen kommt, haelt die Regel fuer
       /groups/{gid} (create). */
    function tripGruppe(gid) {
      return gid is string
        && gid.size() > 0
        && (inFamily(gid) || inGroup(gid));
    }

    function canUseTrip(tripId) {
      return tripId is string
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && tripGruppe(
          get(/databases/$(database)/documents/trips/$(tripId)).data.get('familyId', '')
        );
    }

    // An attachment hangs off either a group trip or a personal calendar day.
    function canUseAttachmentParent(parentId) {
      return parentId is string
        && (
          canUseTrip(parentId)
          || (
            exists(/databases/$(database)/documents/calendarDays/$(parentId))
            && get(/databases/$(database)/documents/calendarDays/$(parentId)).data.ownerUid
              == request.auth.uid
          )
        );
    }

    function registrationInviteCode() {
      return getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.inviteCode;
    }

    function invitedAutoJoin(familyId) {
      return authHasEmail()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && registrationInviteCode() is string
        && exists(/databases/$(database)/documents/memberInvites/$(registrationInviteCode()))
        && get(/databases/$(database)/documents/memberInvites/$(registrationInviteCode())).data.email
          == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/memberInvites/$(registrationInviteCode())).data.familyId
          == familyId
        && !existsAfter(
          /databases/$(database)/documents/memberInvites/$(registrationInviteCode())
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && !(request.auth.uid in resource.data.get('members', []))
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.get('members', []))
        && request.resource.data.members.size()
          == resource.data.get('members', []).size() + 1;
    }

    /* Registrieren mit einer E-Mail-Einladung in eine GRUPPE (seit
       v.35.33.0; vorher trugen Einladungen in eine Kalendergruppe ein).
       Dasselbe Muster wie invitedAutoJoin: das Profil entsteht im selben
       Stapel (darum existsAfter statt isMember), die Einladung ist an die
       E-Mail gebunden, zeigt auf genau diese Gruppe und wird im selben
       Stapel verbraucht. Immer als 'mitglied' — wer eingeladen wird,
       ernennt sich nicht selbst zum Trainer. */
    function einladungsBeitritt(gid, uid) {
      return authHasEmail()
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/users/$(uid))
        && existsAfter(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.keys().hasOnly(['uid', 'rolle', 'seit', 'code'])
        && request.resource.data.uid == uid
        && request.resource.data.rolle == 'mitglied'
        && request.resource.data.code is string
        && registrationInviteCode() == request.resource.data.code
        && exists(/databases/$(database)/documents/memberInvites/$(request.resource.data.code))
        && get(/databases/$(database)/documents/memberInvites/$(request.resource.data.code))
          .data.email == request.auth.token.email.lower()
        && get(/databases/$(database)/documents/memberInvites/$(request.resource.data.code))
          .data.get('gid', '') == gid
        && !existsAfter(/databases/$(database)/documents/memberInvites/$(request.resource.data.code));
    }

    function consumesInvite(code) {
      return authHasEmail()
        && resource.data.email == request.auth.token.email.lower()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.inviteCode
          == code
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email
          == request.auth.token.email.lower()
        && (
          (
            (!('familyId' in resource.data) || resource.data.familyId == null)
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId
              == null
            // Eine Einladung in eine Gruppe ist erst verbraucht, wenn man
            // im selben Stapel wirklich Mitglied geworden ist.
            && (
              !('gid' in resource.data)
              || existsAfter(
                /databases/$(database)/documents/groups/$(resource.data.gid)/members/$(request.auth.uid)
              )
            )
          )
          || (
            resource.data.familyId is string
            && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId
              == resource.data.familyId
            && existsAfter(/databases/$(database)/documents/families/$(resource.data.familyId))
            && request.auth.uid in getAfter(
              /databases/$(database)/documents/families/$(resource.data.familyId)
            ).data.members
          )
        );
    }

    function shareId(ownerUid, targetUid, moduleKey) {
      return ownerUid + '__' + targetUid + '__' + moduleKey;
    }

    function hasModuleShare(ownerUid, moduleKey) {
      return isMember()
        && exists(/databases/$(database)/documents/shares/$(shareId(ownerUid, request.auth.uid, moduleKey)));
    }

    function canEditModule(ownerUid, moduleKey) {
      return hasModuleShare(ownerUid, moduleKey)
        && get(/databases/$(database)/documents/shares/$(shareId(ownerUid, request.auth.uid, moduleKey))).data.role == 'edit';
    }

    function isLegacyParentOf(ownerUid) {
      return isMember()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isParent == true
        && exists(/databases/$(database)/documents/users/$(ownerUid))
        && get(/databases/$(database)/documents/users/$(ownerUid)).data.isTimo == true;
    }

    function hasGuestAccess(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/guestAccess/$(request.auth.uid + '_' + tripId));
    }

    /* Ein Gast sieht einen Termin, wenn er einen Zugang zu GENAU diesem
       Termin hat und dessen Token noch gilt (v.35.50.0). Der Zugang heisst
       {uid}_{eid} — für eine übernommene Reise ist eid die Kennung der
       Reise, und ihr alter Zugang trägt ihr Token, das der Termin
       übernommen hat. Ein neues Token am Termin zieht alle Links zurück. */
    function terminGast(eid, termin) {
      return signedIn()
        && termin.get('gastToken', '') is string
        && termin.get('gastToken', '') != ''
        && exists(/databases/$(database)/documents/guestAccess/$(request.auth.uid + '_' + eid))
        && get(/databases/$(database)/documents/guestAccess/$(request.auth.uid + '_' + eid)).data.token
          == termin.gastToken;
    }

    // ── Family membership and invitations ───────────────────────
    match /memberInvites/{code} {
      allow get: if isAdmin()
                 || (
                   authHasEmail()
                   && resource.data.email == request.auth.token.email.lower()
                 )
                 || (
                   isMember()
                   && resource.data.createdBy == request.auth.uid
                 );
      allow list: if isAdmin()
                  || (
                    isMember()
                    && resource.data.createdBy == request.auth.uid
                  );
      // Seit v.35.33.0 laden Einladungen in eine GRUPPE ein (gid), nicht
      // mehr in eine Kalendergruppe — neue mit familyId gibt es nicht mehr.
      // Offene alte bleiben einloesbar (inviteIsValid, invitedAutoJoin).
      allow create: if isMember()
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email
                      == request.resource.data.email.lower()
                    && request.resource.data.keys().hasOnly([
                      'email', 'gid', 'createdBy', 'createdAt'
                    ])
                    && (
                      // Nur in Firn, ohne Gruppe: nur der Admin.
                      (
                        !('gid' in request.resource.data)
                        && isAdmin()
                      )
                      // In eine Gruppe: wer sie leitet.
                      || (
                        request.resource.data.gid is string
                        && leadsGroup(request.resource.data.gid)
                      )
                    );
      allow update: if false;
      allow delete: if isAdmin()
                    || (
                      isMember()
                      && resource.data.createdBy == request.auth.uid
                      && (
                        (resource.data.get('familyId', null) is string
                          && managesFamily(resource.data.familyId))
                        || (resource.data.get('gid', null) is string
                          && leadsGroup(resource.data.gid))
                      )
                    )
                    || consumesInvite(code);
    }

    match /mail/{mailId} {
      allow create: if isMember()
                    && request.resource.data.keys().hasOnly([
                      'to', 'template', 'createdAt'
                    ])
                    && request.resource.data.to is list
                    && request.resource.data.to.size() == 1
                    && request.resource.data.template is map
                    && request.resource.data.template.keys().hasOnly(['name', 'data'])
                    && request.resource.data.template.name == 'member-invite'
                    && request.resource.data.template.data is map
                    && request.resource.data.template.data.keys().hasOnly([
                      'inviteCode', 'familyName'
                    ])
                    && request.resource.data.template.data.inviteCode is string
                    && request.resource.data.template.data.familyName is string
                    && mailId == (
                      'member-invite-'
                      + request.resource.data.template.data.inviteCode
                    )
                    && existsAfter(
                      /databases/$(database)/documents/memberInvites/$(
                        request.resource.data.template.data.inviteCode
                      )
                    )
                    && getAfter(
                      /databases/$(database)/documents/memberInvites/$(
                        request.resource.data.template.data.inviteCode
                      )
                    ).data.createdBy == request.auth.uid
                    && request.resource.data.to[0] == getAfter(
                      /databases/$(database)/documents/memberInvites/$(
                        request.resource.data.template.data.inviteCode
                      )
                    ).data.email;
      allow read, update, delete: if false;
    }

    match /users/{uid} {
      // Ein Profil traegt E-Mail, Freigaben, Sprache. Bis v.35.46.0 durfte
      // jedes Mitglied jedes Profil lesen UND alle auflisten — die Auswahl
      // im Chat zeigte darum jedem Konto die Adressen aller Konten. Jetzt:
      // lesen nur die Person selbst (auch ein Gast, der prueft, ob er ein
      // Konto hat) und der Admin; auflisten nur der Admin. Namen anderer
      // kommen aus der Namenskarte darunter.
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();

      // A profile may be created without an invite. A supplied invite is
      // email-bound, consumed atomically and, if linked, joins one family.
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && inviteIsValid(request.resource.data)
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.role == 'member'
                    && request.resource.data.isTimo == false
                    && request.resource.data.keys().hasOnly([
                      'displayName', 'email', 'familyId', 'role', 'isTimo',
                      'allowedModules', 'modules', 'createdAt', 'inviteCode'
                    ]);

      // Members may change only their own preferences and planner membership.
      // Admin/module flags and the account email are server-controlled. A
      // self-set familyId must be a group the user really belongs to,
      // otherwise the join-approval flow could be skipped by writing here.
      allow update: if isAdmin()
                    || (
                      isMember()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'modules', 'projectsSeeded', 'familyId', 'role'])
                      && (
                        request.resource.data.get('familyId', null)
                          == resource.data.get('familyId', null)
                        || request.resource.data.get('familyId', null) == null
                        || inFamily(request.resource.data.familyId)
                      )
                    )
                    || (
                      isMember()
                      && request.auth.uid != uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['familyId', 'role'])
                      && managesFamily(request.resource.data.familyId)
                    )
                    // In den TVZA-Kreis mit einem Link des Admins (v.35.56.0,
                    // kreis-einladung.js): nur man selbst, nur kreis = true,
                    // nur die TVZA-Bereiche frei — und nur, wenn der Link
                    // vorher da war, noch gilt und im selben Stapel weg ist.
                    || (
                      isMember()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['kreis', 'allowedModules', 'kreisCode', 'modules'])
                      && request.resource.data.kreis == true
                      && kreisEinladungVerbraucht(request.resource.data.get('kreisCode', ''))
                      && tvzaFrei(request.resource.data.get('allowedModules', {}))
                      && request.resource.data.get('allowedModules', {})
                        .diff(resource.data.get('allowedModules', {})).affectedKeys()
                        .hasOnly(['matura', 'maturatracker', 'food', 'watch', 'projects'])
                    );
      allow delete: if isAdmin();
    }

    // ── Namenskarten (v.35.47.0) ──────────────────────────────────
    // Nichts als der Name. Jedes Mitglied darf eine Karte lesen, deren
    // uid es kennt (aus einer Gruppe, einer Unterhaltung) — auflisten
    // darf nur der Admin, sonst waere es wieder die Liste aller Konten.
    // Schreiben: die Person selbst, und der Admin fuer die, die seit der
    // Umstellung nicht da waren (personen.js, kartenNachtragen).
    match /personen/{uid} {
      allow get: if isMember();
      allow list: if isAdmin();
      allow create, update: if isMember()
                            && (request.auth.uid == uid || isAdmin())
                            && request.resource.data.keys().hasOnly(['name', 'aktualisiert'])
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 80;
      allow delete: if isAdmin();
    }

    // ── Der TVZA-Kreis (v.35.48.0) ──────────────────────────────────
    // Wer im Kreis ist, steht im Profil (kreis, nur vom Admin gesetzt —
    // die Selbstaenderung oben laesst das Feld nicht zu). Hier liegt die
    // Liste dazu, damit Freunde und Familie einander im Chat finden,
    // ohne die Profile lesen zu duerfen: auflisten darf, wer selbst im
    // Kreis ist. Schreiben nur der Admin, zusammen mit dem Profil.
    function imKreis() {
      return isMember()
        && exists(/databases/$(database)/documents/kreis/$(request.auth.uid));
    }

    match /kreis/{uid} {
      allow get: if isMember() && (request.auth.uid == uid || imKreis() || isAdmin());
      allow list: if imKreis() || isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['seit'])
                            && (
                              isAdmin()
                              // Mit einem Link in den Kreis (v.35.56.0): nur sich
                              // selbst, und nur zusammen mit dem Profil, das den
                              // verbrauchten Link trägt.
                              || (
                                isMember()
                                && request.auth.uid == uid
                                && getAfter(/databases/$(database)/documents/users/$(uid)).data.get('kreis', false) == true
                                && kreisEinladungVerbraucht(
                                  getAfter(/databases/$(database)/documents/users/$(uid)).data.get('kreisCode', ''))
                              )
                            );
      allow delete: if isAdmin();
    }

    /* Einladungen in den TVZA-Kreis (v.35.56.0). Michel: "Kann ich jemand
       einfach in TVZA einladen?" Anlegen und auflisten nur der Admin; ein
       Link gilt fuer EINE Person und hoechstens 15 Tage (die App nimmt 7).
       Lesen darf ihn jedes Konto, das den Code kennt (get, nie list) —
       um zu sehen, ob er in den Kreis oder in eine Gruppe fuehrt. Weg
       geht er durch den Admin oder beim Einloesen, im Stapel mit dem
       eigenen Profil, das ihn dann traegt. */
    function kreisEinladungVerbraucht(code) {
      return code is string
        && code.size() == 8
        && exists(/databases/$(database)/documents/kreisEinladungen/$(code))
        && get(/databases/$(database)/documents/kreisEinladungen/$(code)).data.bis > request.time
        && !existsAfter(/databases/$(database)/documents/kreisEinladungen/$(code));
    }

    function tvzaFrei(m) {
      return m is map
        && m.get('matura', false) == true
        && m.get('maturatracker', false) == true
        && m.get('food', false) == true
        && m.get('watch', false) == true
        && m.get('projects', false) == true;
    }

    match /kreisEinladungen/{code} {
      allow get: if isMember();
      allow list: if isAdmin();
      allow create: if isAdmin()
                    && code.matches('^[A-HJKMNP-Z2-9]{8}$')
                    && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'bis', 'fuer'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.bis is timestamp
                    && request.resource.data.bis > request.time
                    && request.resource.data.bis < request.time + duration.value(15, 'd')
                    && (!('fuer' in request.resource.data)
                        || (request.resource.data.fuer is string && request.resource.data.fuer.size() <= 60));
      allow delete: if isAdmin()
                    || (
                      isMember()
                      && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('kreisCode', '') == code
                      && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('kreis', false) == true
                    );
    }

    match /users/{uid}/reminders/{reminderId} {
      allow read, create, update, delete: if isMember()
                                           && request.auth.uid == uid;
    }

    // Trainingsbereich: das eingelesene Wochenprogramm liegt als
    // JSON-Zeichenkette, weil Firestore keine Arrays in Arrays kennt und
    // die Originaltabellen genau das sind. Die Grenze hält ein einzelnes
    // Dokument klein genug (Firestore erlaubt 1 MiB).
    match /users/{uid}/trainingPrograms/{programId} {
      allow read, delete: if isMember()
                           && request.auth.uid == uid;
      allow create, update: if isMember()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly([
                              'schema', 'id', 'json', 'updatedAt'
                            ])
                            && request.resource.data.schema == 1
                            && request.resource.data.json is string
                            && request.resource.data.json.size() <= 900000;
    }

    // Ein Dokument je Trainingstag. units hält die Einheiten des Tages;
    // die Grenze verhindert, dass ein Fehler im Client ein Dokument
    // unbegrenzt wachsen lässt.
    match /users/{uid}/trainingLogs/{trainingDate} {
      allow read, delete: if isMember()
                           && request.auth.uid == uid;
      allow create, update: if isMember()
                            && request.auth.uid == uid
                            && trainingDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
                            && request.resource.data.keys().hasOnly([
                              'schema', 'units', 'updatedAt'
                            ])
                            && request.resource.data.schema == 1
                            && request.resource.data.units is map
                            && request.resource.data.units.size() <= 20;
    }

    match /users/{uid}/maturaProgress/{progressId} {
      allow read, delete: if isMember()
                           && request.auth.uid == uid;
      allow create, update: if isMember()
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasOnly([
                              'state', 'schema', 'updatedAt'
                            ])
                            && request.resource.data.state is map
                            && request.resource.data.state.size() <= 100
                            && request.resource.data.schema == 1;
    }

    // ── Guests ───────────────────────────────────────────────────
    match /guestProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMember());
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && !exists(/databases/$(database)/documents/users/$(uid))
                    && !exists(/databases/$(database)/documents/guestProfiles/$(uid))
                    && request.resource.data.keys().hasOnly([
                      'email', 'name', 'createdAt', 'lastActiveAt'
                    ]);
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['name', 'lastActiveAt']);
      allow delete: if isMember()
                    || (signedIn() && request.auth.uid == uid
                        && exists(/databases/$(database)/documents/users/$(uid)));
    }

    match /guestAccess/{docId} {
      allow get: if signedIn()
                 && (isMember() || docId.split('_')[0] == request.auth.uid);
      allow list: if isMember();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && (
                      (
                        docId == (request.resource.data.uid + '_' + request.resource.data.tripId)
                        && request.resource.data.keys().hasOnly([
                          'uid', 'tripId', 'token', 'createdAt'
                        ])
                        && exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId))
                        && request.resource.data.token
                          == get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.guestToken
                      )
                      /* Seit v.35.50.0: ein Termin einer Gruppe (Reisen sind
                         Termine geworden). Das Token muss das des Termins sein. */
                      || (
                        docId == (request.resource.data.uid + '_' + request.resource.data.eid)
                        && request.resource.data.keys().hasOnly([
                          'uid', 'gid', 'eid', 'token', 'createdAt'
                        ])
                        && request.resource.data.gid is string
                        && request.resource.data.eid is string
                        && request.resource.data.token is string
                        && request.resource.data.token.size() > 0
                        && exists(/databases/$(database)/documents/groups/$(request.resource.data.gid)/events/$(request.resource.data.eid))
                        && request.resource.data.token
                          == get(/databases/$(database)/documents/groups/$(request.resource.data.gid)/events/$(request.resource.data.eid)).data.get('gastToken', '')
                      )
                    );
      allow update: if false;
      allow delete: if isMember();
    }

    match /tripViews/{viewId} {
      allow read: if isMember();
      allow create: if signedIn()
                    && isGuest()
                    && request.resource.data.guestUid == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'tripId', 'guestUid', 'viewedAt'
                    ])
                    && hasGuestAccess(request.resource.data.tripId);
      allow update, delete: if false;
    }

    // ── Direct messages ──────────────────────────────────────────
    match /dms/{convId} {
      allow read: if signedIn()
                  && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants[0]
                      != request.resource.data.participants[1]
                    && convId == (
                      request.resource.data.participants[0] + '__'
                      + request.resource.data.participants[1]
                    );
      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'participantNames', 'lastMessage', 'lastAt', 'lastSender',
                        'unread', 'lastRead', 'typing'
                      ]);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn()
                    && request.auth.uid in get(
                      /databases/$(database)/documents/dms/$(convId)
                    ).data.participants;
        allow create: if signedIn()
                      && request.auth.uid == request.resource.data.sender
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.keys().hasOnly([
                        'text', 'sender', 'createdAt'
                      ])
                      && request.auth.uid in get(
                        /databases/$(database)/documents/dms/$(convId)
                      ).data.participants;
        allow update, delete: if false;
      }
    }

    // ── Public project feed ──────────────────────────────────────
    // Public means public. No password or secret URL is stored here.
    match /publicProjects/{docId} {
      allow read: if true;
      allow create: if isMember()
                    && request.auth.uid == request.resource.data.ownerUid
                    && docId.split('__')[0] == request.auth.uid
                    && request.resource.data.url is string
                    && request.resource.data.url.lower().matches('https?://.*')
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'emoji', 'name', 'url', 'updatedAt'
                    ]);
      allow update: if isMember()
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && docId.split('__')[0] == request.auth.uid
                    && request.resource.data.url is string
                    && request.resource.data.url.lower().matches('https?://.*')
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'emoji', 'name', 'url', 'updatedAt'
                    ]);
      allow delete: if isMember()
                    && request.auth.uid == resource.data.ownerUid;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Module sharing ───────────────────────────────────────────
    // Canonical id: <ownerUid>__<targetUid>__<module>.
    match /shares/{id} {
      allow read: if isMember()
                  && (
                    resource.data.ownerUid == request.auth.uid
                    || resource.data.targetUid == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isMember()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.targetUid != request.auth.uid
                    && id == shareId(
                      request.resource.data.ownerUid,
                      request.resource.data.targetUid,
                      request.resource.data.module
                    )
                    && request.resource.data.module in ['ski', 'food', 'watch']
                    && request.resource.data.role in ['view', 'edit']
                    && request.resource.data.keys().hasOnly([
                      'ownerUid', 'ownerName', 'module', 'targetUid',
                      'targetEmail', 'targetName', 'role', 'createdAt'
                    ]);
      allow update: if isMember()
                    && request.auth.uid == resource.data.ownerUid
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.targetUid == resource.data.targetUid
                    && request.resource.data.module == resource.data.module
                    && id == shareId(
                      resource.data.ownerUid,
                      resource.data.targetUid,
                      resource.data.module
                    )
                    && request.resource.data.role in ['view', 'edit'];
      allow delete: if isMember()
                    && (request.auth.uid == resource.data.ownerUid || isAdmin());
    }

    // ── Per-user data ────────────────────────────────────────────
    match /projects/{ownerUid}/{p=**} {
      allow read, write: if isMember() && request.auth.uid == ownerUid;
    }

    match /skitracker/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'ski')
                    || isLegacyParentOf(ownerUid)
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'ski')
                   );
    }

    match /foodlog/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'food')
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'food')
                   );
    }

    match /watchlist/{ownerUid}/{p=**} {
      allow read: if isMember()
                  && (
                    request.auth.uid == ownerUid
                    || hasModuleShare(ownerUid, 'watch')
                  );
      allow write: if isMember()
                   && (
                     request.auth.uid == ownerUid
                     || canEditModule(ownerUid, 'watch')
                   );
    }

    // ── Shared family data ───────────────────────────────────────
    match /customFoods/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    match /foodRequests/{id} {
      allow read: if isAdmin()
                  || (
                    isMember()
                    && resource.data.requestedByEmail == request.auth.token.email.lower()
                  );
      allow create: if isMember()
                    && request.resource.data.requestedByEmail
                      == request.auth.token.email.lower();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /secrets/{id} {
      allow read: if isMember();
      allow write: if false;
    }

    // ── Calendar groups ──────────────────────────────────────────
    // The group document holds the member list and the invite token, so only
    // its own members may read it. Searching for a group by name goes through
    // /familyDirectory, which carries nothing but the name.
    match /familyDirectory/{familyId} {
      allow read: if isMember();
      allow create, update: if managesFamily(familyId)
                            && request.resource.data.name is string
                            && request.resource.data.name.size() > 0
                            && request.resource.data.name.size() <= 80
                            && request.resource.data.keys().hasOnly(['name']);
      allow delete: if managesFamily(familyId);
    }

    match /families/{id} {
      allow get, list: if inFamilyDoc() || managesFamilyDoc();

      allow create: if isMember()
                    && request.resource.data.headUid == request.auth.uid
                    && request.resource.data.members == [request.auth.uid]
                    && request.resource.data.managers == [request.auth.uid]
                    && request.resource.data.pendingRequests == []
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.inviteToken is string
                    && request.resource.data.inviteToken.size() >= 8
                    && request.resource.data.keys().hasOnly([
                      'name', 'headUid', 'managers', 'members', 'pendingRequests',
                      'inviteToken', 'calendarColor', 'createdAt'
                    ]);

      allow update: if
                    // Managers curate the group. Only the head may change the
                    // manager list or hand the lead over.
                    (
                      managesFamilyDoc()
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly([
                          'name', 'calendarColor', 'members', 'managers',
                          'headUid', 'pendingRequests', 'inviteToken'
                        ])
                      && request.resource.data.headUid is string
                      && request.auth.uid in request.resource.data.members
                      && (
                        request.resource.data.headUid == resource.data.headUid
                        || resource.data.get('headUid', '') == request.auth.uid
                      )
                      && (
                        request.resource.data.get('managers', [])
                          == resource.data.get('managers', [])
                        || resource.data.get('headUid', '') == request.auth.uid
                      )
                    )
                    // Registration with an email-bound group invitation adds
                    // only the new account and consumes the invite atomically.
                    || invitedAutoJoin(id)
                    // Joining through an invite link: the caller proves it knows
                    // the token by sending it back unchanged, and may add nobody
                    // but itself.
                    || (
                      isMember()
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['members', 'inviteToken'])
                      && resource.data.inviteToken is string
                      && resource.data.inviteToken.size() >= 8
                      && request.resource.data.inviteToken == resource.data.inviteToken
                      && !(request.auth.uid in resource.data.get('members', []))
                      && request.resource.data.members
                        == resource.data.get('members', []).concat([request.auth.uid])
                    )
                    // Asking to join: adds only itself to pendingRequests.
                    || (
                      isMember()
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['pendingRequests'])
                      && !(request.auth.uid in resource.data.get('members', []))
                      && request.resource.data.pendingRequests
                        == resource.data.get('pendingRequests', []).concat([request.auth.uid])
                    )
                    // Leaving: removes only itself. The head hands over first.
                    || (
                      isMember()
                      && request.auth.uid in resource.data.get('members', [])
                      && resource.data.get('headUid', '') != request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['members', 'managers'])
                      && request.resource.data.members
                        == resource.data.get('members', []).removeAll([request.auth.uid])
                      && request.resource.data.get('managers', [])
                        == resource.data.get('managers', []).removeAll([request.auth.uid])
                    )
                    // Uebernahme (v.35.32.0): der Kopf markiert die Familie als
                    // uebernommen — nur dieses eine Feld, nur auf true, und nur,
                    // wenn die Gruppe mit derselben Kennung wirklich steht.
                    || (
                      isMember()
                      && resource.data.get('headUid', '') == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['uebernommen'])
                      && request.resource.data.uebernommen == true
                      && exists(/databases/$(database)/documents/groups/$(id))
                    );

      allow delete: if isMember()
                    && resource.data.get('headUid', '') == request.auth.uid;
    }

    match /groups/{gid} {
      // Der Admin sieht die Gruppen (nur die Gruppe selbst, keine
      // Termine, keine Mitglieder), um ihren Assistenten freizuschalten
      // (v.35.55.0).
      allow get, list: if inGroup(gid) || isAdmin();

      // Eine Gruppe entsteht nie ohne ihren Kopf. existsAfter prueft den
      // Zustand NACH dem Schreiben, das Mitgliedsdokument muss also im
      // selben Stapel liegen — beide entstehen zusammen oder gar nicht.
      // Ohne diese Klammer gaebe es kopflose Gruppen, die niemand mehr
      // verwalten oder loeschen kann.
      allow create: if isMember()
                    && request.resource.data.headUid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 80
                    && request.resource.data.art in ['familie', 'kader', 'organisation']
                    && request.resource.data.bereiche is map
                    && request.resource.data.inviteToken is string
                    && request.resource.data.inviteToken.size() >= 8
                    && request.resource.data.keys().hasOnly([
                      'name', 'art', 'headUid', 'bereiche',
                      'inviteToken', 'icsToken', 'farbe', 'createdAt'
                    ])
                    && existsAfter(
                      /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)
                    )
                    // Die Kennung einer alten Familie darf nur deren Kopf
                    // belegen. Sonst legte jemand groups/{fremdeFamilie} an,
                    // waere dort Kopf — und laese ueber tripGruppe() die
                    // Reisen einer Familie, der er nie angehoert hat.
                    && (
                      !exists(/databases/$(database)/documents/families/$(gid))
                      || get(/databases/$(database)/documents/families/$(gid))
                        .data.get('headUid', '') == request.auth.uid
                    );

      /* Der eigene Assistent der Gruppe (v.35.53.0): ein Name und, was er
         beachten soll. Kurz, weil beides mit jeder Frage an Gemini geht. */
      function assistentGueltig(d) {
        return !('assistent' in d)
          || (d.assistent is map
              && d.assistent.keys().hasOnly(['name', 'anweisung'])
              && d.assistent.get('name', '') is string
              && d.assistent.get('name', '').size() > 0
              && d.assistent.get('name', '').size() <= 30
              && d.assistent.get('anweisung', '') is string
              && d.assistent.get('anweisung', '').size() <= 600);
      }

      allow update: if
                    // Kuratieren: Name, Farbe, eingeschaltete Bereiche, ein
                    // frischer Einladungscode und der Assistent. 'art' steht
                    // bewusst NICHT in dieser Liste — sie entscheidet ueber
                    // Wortwahl und Vorgaben, und ein Wechsel im Betrieb
                    // wuerde bestehende Termine und Rollen sinnlos machen.
                    (
                      leadsGroup(gid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['name', 'farbe', 'bereiche', 'inviteToken', 'icsToken', 'assistent'])
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 80
                      && request.resource.data.bereiche is map
                      && assistentGueltig(request.resource.data)
                    )
                    // Freischalten: der Assistent der Gruppe (ki) — nur der
                    // Admin, nie die Leitung selbst (v.35.55.0; spaeter, wenn
                    // die Gruppe dafuer zahlt).
                    || (
                      isAdmin()
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ki'])
                      && request.resource.data.ki is bool
                    )
                    // Uebergabe: nur der Kopf, und nur an jemanden, der
                    // bereits Mitglied ist.
                    || (
                      headsGroup(gid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['headUid'])
                      && request.resource.data.headUid is string
                      && exists(
                        /databases/$(database)/documents/groups/$(gid)/members/$(request.resource.data.headUid)
                      )
                    );

      allow delete: if headsGroup(gid);
    }

    /* "In welchen Gruppen bin ich?" laeuft ueber
       collectionGroup('members'). Dafuer greift die Regel unter
       /groups/{gid}/members NICHT — eine Sammelgruppen-Abfrage wird
       ausschliesslich gegen eine Regel mit rekursivem Platzhalter
       geprueft.

       Die Klammer sitzt im Platzhalter selbst: {uid} ist die
       Dokument-ID, und weil in diesem Modell die Dokument-ID die uid
       IST, laesst diese Regel nur Abfragen durch, deren Ergebnis
       ausschliesslich aus eigenen Mitgliedsdokumenten besteht. Taucht
       ein fremdes darin auf, faellt die ganze Abfrage. Der Filter
       where('uid','==',eigene uid) im Client ist damit erzwungen und
       nicht bloss Konvention.

       Bewusst nur 'list': Einzelabruf und alles Schreibende laufen
       weiter ueber den Block unten, der an die Gruppe gebunden ist. */
    match /{path=**}/members/{uid} {
      allow list: if isMember() && uid == request.auth.uid;
    }

    match /groups/{gid}/members/{uid} {
      // Mitglieder sehen einander — ohne das gaebe es keine Kaderliste.
      allow get, list: if inGroup(gid);

      // Zweiter Weg (hinter dem ||): registrieren mit einer E-Mail-
      // Einladung in diese Gruppe. isMember() waere dort noch falsch — das
      // Profil entsteht erst im selben Stapel. Siehe einladungsBeitritt().
      allow create: if (isMember()
                    && request.resource.data.uid == uid
                    && request.resource.data.rolle is string
                    && request.resource.data.keys().hasOnly(['uid', 'rolle', 'seit', 'code'])
                    && (
                      // Der Gruender legt sich selbst als Kopf an. Erlaubt nur,
                      // wenn die Gruppe im selben Stapel ihn auch als Kopf
                      // fuehrt — sonst koennte sich jemand zum Kopf einer
                      // fremden Gruppe erklaeren, indem er einfach ein
                      // Mitgliedsdokument schreibt.
                      (
                        request.auth.uid == uid
                        && request.resource.data.rolle == 'head'
                        && getAfter(/databases/$(database)/documents/groups/$(gid))
                          .data.headUid == request.auth.uid
                      )
                      // Die Leitung nimmt Athleten auf. Wer mitleiten darf,
                      // entscheidet allein der Kopf — sonst waere das Aufnehmen
                      // lockerer als das Befoerdern, und ein Trainer koennte
                      // sich beliebig viele Mit-Trainer danebenstellen.
                      || (
                        leadsGroup(gid)
                        && request.resource.data.rolle == 'mitglied'
                      )
                      // Der Kopf ernennt weitere Trainer. Beliebig viele —
                      // begrenzt ist nur der Kopf selbst, nicht die Leitung.
                      || (
                        headsGroup(gid)
                        && request.resource.data.rolle in ['staff', 'mitglied']
                      )
                      // Selbst beitreten mit einem Code. Ohne diesen Weg
                      // gaebe es gar keinen: die Leitung kann Leute nur
                      // ueber ihre uid aufnehmen, und die kennt kein
                      // Trainer.
                      //
                      // Der Code steht im Dokument, weil eine Regel nur
                      // pruefen kann, was geschrieben oder gelesen wird.
                      // Er ist harmlos — es ist der Code, den man ohnehin
                      // bekommen hat — und macht nachvollziehbar, ueber
                      // welche Einladung jemand hereinkam.
                      //
                      // Immer als 'mitglied': wer beitritt, ernennt sich
                      // nicht selbst zum Trainer.
                      //
                      // Und nur, solange der Code gilt (v.35.53.0). Alte
                      // Codes ohne 'bis' gelten bis zum 15. Oktober 2026 —
                      // wer einen verschickt hat, soll ihn nicht ueber Nacht
                      // verlieren.
                      || (
                        request.auth.uid == uid
                        && request.resource.data.rolle == 'mitglied'
                        && request.resource.data.code is string
                        && exists(
                          /databases/$(database)/documents/groupInvites/$(request.resource.data.code)
                        )
                        && get(
                          /databases/$(database)/documents/groupInvites/$(request.resource.data.code)
                        ).data.gid == gid
                        && get(
                          /databases/$(database)/documents/groupInvites/$(request.resource.data.code)
                        ).data.get('bis', timestamp.date(2026, 10, 15)) > request.time
                      )
                    ))
                    || einladungsBeitritt(gid, uid);

      // Rollen vergibt nur der Kopf — wie bei families, wo auch nur der
      // Kopf die Managerliste aendert. Duerfte die Leitung das, koennten
      // sich zwei Trainer gegenseitig herabstufen.
      allow update: if headsGroup(gid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['rolle'])
                    && request.resource.data.rolle in ['staff', 'mitglied']
                    && resource.data.get('rolle', '') != 'head';

      allow delete: if
                    // Selbst gehen. Der Kopf uebergibt vorher — sonst bliebe
                    // eine Gruppe ohne Kopf zurueck.
                    (
                      request.auth.uid == uid
                      && resource.data.get('rolle', '') != 'head'
                    )
                    // Die Leitung entfernt jemanden, aber nie den Kopf.
                    || (
                      leadsGroup(gid)
                      && resource.data.get('rolle', '') != 'head'
                    )
                    // Der Kopf geht zuletzt, wenn er die Gruppe geloescht hat
                    // (v.35.59.0, gruppeLoeschen in groups.js). Solange es sie
                    // gibt, bleibt er — eine Gruppe ohne Kopf verwaltet
                    // niemand mehr.
                    || (
                      request.auth.uid == uid
                      && resource.data.get('rolle', '') == 'head'
                      && !exists(/databases/$(database)/documents/groups/$(gid))
                    );
    }

    /* Kontakte — die Karte einer Person: Geburtsdatum, Telefon, E-Mail,
       Adresse, eine Notiz fuer die Trainer, bis zu vier Eltern.

       LESEN darf die Leitung und die Person selbst. Sonst niemand: ein
       Athlet sieht nie die Nummer der Mutter eines anderen Athleten, und
       in einem Kader sind die meisten minderjaehrig. 'list' nur fuer die
       Leitung — sie baut daraus den Verteiler.

       SCHREIBEN dieselben: die Leitung traegt fuer ein Kind ein, der
       Athlet fuer sich selbst. Eine Karte gibt es nur fuer ein Mitglied
       DIESER Gruppe — fuer Fremde legt niemand eine an.

       LOESCHEN die Leitung oder die Person selbst. Wer die Gruppe
       verlaesst oder entfernt wird, dessen Karte geht im selben Batch mit
       (groups.js). exists() sieht dabei den Stand VOR dem Batch, also ist
       man beim Loeschen der eigenen Karte noch Mitglied. */
    match /groups/{gid}/kontakte/{uid} {
      function eigene() {
        return inGroup(gid) && request.auth.uid == uid;
      }
      function kontaktGueltig(d) {
        return d.keys().hasOnly([
                 'uid', 'geburt', 'telefon', 'email', 'adresse', 'notiz', 'eltern',
                 'geaendertVon', 'geaendertAm'
               ])
          && d.uid == uid
          && d.geaendertVon == request.auth.uid
          && (!('geburt' in d) || (d.geburt is string && d.geburt.matches('\\d{4}-\\d{2}-\\d{2}')))
          && (!('telefon' in d) || (d.telefon is string && d.telefon.size() <= 30))
          && (!('email' in d) || (d.email is string && d.email.size() <= 120))
          && (!('adresse' in d) || (d.adresse is string && d.adresse.size() <= 160))
          && (!('notiz' in d) || (d.notiz is string && d.notiz.size() <= 500))
          && (!('eltern' in d) || (d.eltern is list && d.eltern.size() <= 4));
      }

      allow get: if leadsGroup(gid) || eigene();
      allow list: if leadsGroup(gid);
      allow create, update: if (leadsGroup(gid) || eigene())
                            && exists(/databases/$(database)/documents/groups/$(gid)/members/$(uid))
                            && kontaktGueltig(request.resource.data);
      allow delete: if leadsGroup(gid) || eigene();
    }

    /* Einladungscodes. Ein Code zeigt auf genau eine Gruppe und gilt
       fuer beliebig viele Beitritte — anders als memberInvites, die
       an eine E-Mail gebunden und einmalig sind. Ein Kader laedt zehn
       Athleten mit demselben Zettel ein, nicht mit zehn Zetteln.

       Zurueckziehen heisst loeschen: danach traegt der Code ins Leere,
       und wer schon drin ist, bleibt drin.

       'get' fuer jedes Mitglied, damit der Beitretende die Gruppe
       ueberhaupt nachschlagen kann — die Gruppe selbst darf er ja noch
       nicht lesen. 'list' nur fuer die Leitung und nur mit dem Filter auf
       ihre Gruppe — sonst waeren alle Codes des Systems aufzaehlbar.

       Seit v.35.53.0 kurz und mit Ablauf (Michel: "wichtig ist, dass der
       Code mal ablaeuft"): acht Zeichen aus einem Alphabet ohne
       Verwechsler, 'bis' hoechstens 15 Tage nach dem Anlegen. Raten
       scheidet trotzdem aus — 31^8 Codes, nicht auflistbar, jeder
       Versuch ein Lesen, und nach Ablauf wertlos (siehe Beitritt in
       members). */
    match /groupInvites/{code} {
      allow get: if isMember();
      allow list: if isMember() && leadsGroup(resource.data.gid);

      allow create: if isMember()
                    && code.matches('^[A-HJKMNP-Z2-9]{8}$')
                    && request.resource.data.gid is string
                    && leadsGroup(request.resource.data.gid)
                    && request.resource.data.keys().hasOnly(['gid', 'createdBy', 'createdAt', 'bis'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.bis is timestamp
                    && request.resource.data.bis > request.time
                    && request.resource.data.bis < request.time + duration.value(15, 'd');

      allow delete: if leadsGroup(resource.data.get('gid', ''));
    }

    /* Termine einer Gruppe. Drei Arten, die sich wirklich verschieden
       verhalten: ein Training dauert zwei Stunden, ein Lager eine
       Woche, ein Rennen hat eine Startzeit und danach ein Ergebnis.

       von/bis sind 'JJJJ-MM-TT' und keine Timestamps — ein Lager vom
       3. bis 10. Oktober ist ein Datum, kein Zeitpunkt. Ein Timestamp
       zwaenge dazu, eine Uhrzeit und eine Zeitzone zu erfinden, die
       niemand gemeint hat.

       Wer den Kalender fuehrt, fuehrt auch die Termine: die Leitung
       schreibt, alle Mitglieder lesen. Ein Athlet traegt kein Rennen
       ein — aber er sagt zu, und das steht eine Ebene tiefer. */
    match /groups/{gid}/events/{eid} {
      /* Das eigene Wort eines Termins: "Elternabend", "Physio". Die Art
         bleibt das Verhalten (training/lager/rennen); das Wort ist nur,
         wie er heisst. Fehlt es, gilt das Wort der Art. Dieselbe Grenze
         wie BEZEICHNUNG_MAX in termine.js. */
      function bezeichnungGueltig(d) {
        return !('bezeichnung' in d)
          || (d.bezeichnung is string && d.bezeichnung.size() > 0 && d.bezeichnung.size() <= 40);
      }

      /* Das Programm und die Seite, aus der es kommt (v.35.50.0, vorher
         nur an der Reise), dazu Abfahrten je Person und die Packliste.
         Dieselben Grenzen wie in programm.js: 300 Punkte, die Seite fast
         so gross, wie das Dokument sein darf. Schreiben darf das alles nur
         die Leitung — abgehakt wird ein Programm nicht (Michel). */
      function programmGueltig(d) {
        return (!('programm' in d) || (d.programm is list && d.programm.size() <= 300))
          && (!('packliste' in d) || (d.packliste is list && d.packliste.size() <= 200))
          && (!('abfahrten' in d) || (d.abfahrten is map && d.abfahrten.size() <= 300))
          && (!('planHtml' in d) || (d.planHtml is string && d.planHtml.size() <= 900000))
          && (!('planUrl' in d) || (d.planUrl is string && d.planUrl.size() <= 2000))
          && (!('gastToken' in d) || (d.gastToken is string && d.gastToken.size() <= 64));
      }

      allow get: if inGroup(gid) || terminGast(eid, resource.data);
      allow list: if inGroup(gid);

      allow create: if leadsGroup(gid)
                    && request.resource.data.art in ['training', 'lager', 'rennen']
                    && request.resource.data.titel is string
                    && request.resource.data.titel.size() > 0
                    && request.resource.data.titel.size() <= 120
                    && request.resource.data.von is string
                    && request.resource.data.von.matches('\\d{4}-\\d{2}-\\d{2}')
                    && request.resource.data.createdBy == request.auth.uid
                    && bezeichnungGueltig(request.resource.data)
                    && programmGueltig(request.resource.data)
                    && request.resource.data.keys().hasOnly([
                      'art', 'bezeichnung', 'titel', 'von', 'bis', 'zeit', 'bisZeit', 'ort', 'notiz',
                      'disziplin', 'startnummer', 'ergebnis',
                      'abgesagt', 'absageGrund',
                      'programm', 'planHtml', 'planUrl', 'gastToken', 'abfahrten', 'packliste',
                      'createdBy', 'createdAt'
                    ]);

      /* 'art' fehlt hier mit Absicht. Aus einem Rennen ein Training zu
         machen wuerde Startnummer und Ergebnis sinnlos daneben stehen
         lassen; wer sich vertan hat, loescht und legt neu an. Dieselbe
         Ueberlegung wie bei der Gruppenart. */
      allow update: if leadsGroup(gid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly([
                        'bezeichnung', 'titel', 'von', 'bis', 'zeit', 'bisZeit', 'ort', 'notiz',
                        'disziplin', 'startnummer', 'ergebnis',
                        'abgesagt', 'absageGrund',
                        'programm', 'planHtml', 'planUrl', 'gastToken', 'abfahrten', 'packliste'
                      ])
                    && bezeichnungGueltig(request.resource.data)
                    && programmGueltig(request.resource.data)
                    && request.resource.data.titel is string
                    && request.resource.data.titel.size() > 0
                    && request.resource.data.titel.size() <= 120;

      allow delete: if leadsGroup(gid);

    }

    /* Trainingsplaene einer Gruppe.

       Das Feld 'fuer' traegt die eigentliche Anforderung: ein Plan gilt
       entweder fuer den ganzen Kader ('alle') oder fuer genau einen
       Athleten (dessen uid). Damit kann ein Trainer sechs Athleten
       sechs verschiedene Plaene geben, ohne sechs Gruppen zu brauchen —
       das ging im alten Modell ueberhaupt nicht.

       'json' ist dasselbe Format wie users/{uid}/trainingPrograms: eine
       Zeichenkette, weil Firestore keine Arrays in Arrays kennt und die
       eingelesenen Wochentabellen genau das sind. Dadurch liest der
       vorhandene Parser einen Gruppenplan unveraendert.

       Lesen darf ein Athlet nur, was fuer ihn bestimmt ist. Bei einer
       Abfrage prueft Firestore JEDES Ergebnisdokument einzeln — der
       Client muss also where('fuer','in',['alle', eigene uid]) filtern,
       sonst faellt die ganze Abfrage. Die Leitung sieht alles. */
    match /groups/{gid}/plaene/{planId} {
      allow get, list: if inGroup(gid)
                    && (
                      resource.data.get('fuer', '') == 'alle'
                      || resource.data.get('fuer', '') == request.auth.uid
                      || leadsGroup(gid)
                    );

      allow create, update: if leadsGroup(gid)
                    && request.resource.data.titel is string
                    && request.resource.data.titel.size() > 0
                    && request.resource.data.titel.size() <= 120
                    && request.resource.data.json is string
                    && request.resource.data.json.size() <= 900000
                    && request.resource.data.fuer is string
                    && request.resource.data.erstelltVon == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'titel', 'json', 'fuer', 'notiz',
                      'erstelltVon', 'erstelltAm'
                    ]);

      allow delete: if leadsGroup(gid);
    }

    /* Trainingsprotokoll einer Gruppe: was ein Athlet an einem Tag
       tatsaechlich gemacht hat.

       Es liegt hier und nicht unter users/{uid}/trainingLogs, weil ein
       Trainer sehen muss, ob der Plan gemacht wurde — und ein
       owner-only Dokument gibt das nicht her. Das Persoenliche bleibt
       persoenlich: users/{uid}/trainingLogs ist unberuehrt und traegt
       weiterhin das eigene Training. Hier steht nur, was zu einem Plan
       DIESER Gruppe gehoert.

       Dokument-ID ist uid__datum. Damit gibt es pro Person und Tag
       genau ein Protokoll, ohne dass jemand nach Dubletten suchen
       muesste.

       Geschrieben wird nur das eigene. Ein Trainer, der eintraegt, was
       ein Athlet geschafft habe, macht aus einem Protokoll eine
       Behauptung — loeschen darf er, damit er nach einem Irrtum
       aufraeumen kann. */
    match /groups/{gid}/protokoll/{id} {
      /* get fragt die Kennung, nicht das Dokument: ein Athlet öffnet eine
         Einheit an einem Tag, an dem er noch nichts eingetragen hat — das
         Dokument gibt es dann nicht, resource ist null, und bis v.35.50.0
         lehnte die Regel das Lesen darum ab. Der Player meldete "Der Plan
         liess sich nicht laden" (Michel, am iPhone). */
      allow get: if inGroup(gid)
                 && (id.split('__')[0] == request.auth.uid || leadsGroup(gid));
      allow list: if inGroup(gid)
                    && (
                      resource.data.get('uid', '') == request.auth.uid
                      || leadsGroup(gid)
                    );

      allow create, update: if inGroup(gid)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.datum is string
                    && request.resource.data.datum.matches('\\d{4}-\\d{2}-\\d{2}')
                    && id == request.auth.uid + '__' + request.resource.data.datum
                    && request.resource.data.units is map
                    && request.resource.data.units.size() <= 20
                    && request.resource.data.keys().hasOnly([
                      'uid', 'datum', 'units', 'updatedAt'
                    ]);

      allow delete: if (inGroup(gid) && resource.data.get('uid', '') == request.auth.uid)
                    || leadsGroup(gid);
    }

    /* Rennergebnisse. EIN Ergebnis pro Athlet und Rennen — nicht eines
       pro Rennen. Genau das war der erste Entwurf, und er war falsch:
       ein Rennen hat so viele Ergebnisse wie Starter.

       Die Dokument-ID ist zusammengesetzt (eventId__uid), wie bei
       shares. Damit kann derselbe Athlet im selben Rennen nicht zweimal
       gewertet werden, ohne dass die Regel Dubletten suchen muesste.

       Gespeichert werden ZEITEN, nicht Punkte. Die Punkte entstehen aus
       Zeit, Siegerzeit und Disziplin; stuenden sie hier, waeren sie
       falsch, sobald die FIS einen Faktor aendert. Die Formel gehoert an
       eine Stelle, nicht in jedes Dokument.

       Eintragen darf die Leitung. Ein Ergebnis ist eine Feststellung,
       kein Selbstauskunft — sonst traegt jeder ein, was ihm passt. */
    match /groups/{gid}/ergebnisse/{id} {
      allow get, list: if inGroup(gid);

      allow create, update: if leadsGroup(gid)
                    && request.resource.data.uid is string
                    && request.resource.data.eventId is string
                    && id == request.resource.data.eventId + '__' + request.resource.data.uid
                    && request.resource.data.erfasstVon == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'uid', 'eventId', 'rang', 'zeit', 'siegerZeit',
                      'zuschlag', 'notiz', 'erfasstVon', 'erfasstAm'
                    ]);

      allow delete: if leadsGroup(gid);
    }

    /* Ausschreibungen und andere Anhaenge an einem Termin.
       Bei einem Lager oder einem Rennen kommt die Ausschreibung als
       PDF, und sie gehoert an den Termin — nicht in eine Mail, die
       drei Wochen spaeter niemand mehr findet.

       Die Datei liegt als Data-URL IM Dokument, genau wie bei
       /attachments fuer die Reisen. Das ist der Weg ohne Cloud
       Storage, den der Spark-Tarif zulaesst. Firestore erlaubt 1 MiB
       pro Dokument; die Grenze von 950 000 gilt fuer die codierte
       Zeichenkette und laesst damit rund 700 KB echtes PDF zu. Was
       groesser ist, gehoert spaeter nach R2 — dafuer ist der Worker da.

       Anders als bei /attachments ist update hier ERLAUBT: eine
       Ausschreibung wird nachgereicht, korrigiert und ersetzt. Ein
       Anhang, den man nur loeschen und neu anlegen kann, verliert
       dabei jedes Mal seinen Platz in der Liste. */
    match /groups/{gid}/events/{eid}/anhaenge/{id} {
      allow get, list: if inGroup(gid);

      /* Unterlagen bringt die Leitung — auch seit Termine und Reisen eins
         sind (v.35.50.0; an der Reise durfte das jedes Mitglied). Michel:
         ändern soll nur, wer die Gruppe führt. */
      allow create, update: if leadsGroup(gid)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && request.resource.data.size is number
                    && request.resource.data.size <= 950000
                    && request.resource.data.dataUrl is string
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'name', 'type', 'size', 'dataUrl', 'by', 'at'
                    ]);

      allow delete: if leadsGroup(gid);
    }

    /* Die Packliste: die Punkte legt die Leitung am Termin an
       (packliste), abgehakt wird für jede Person einzeln — hier, unter
       ihrer uid, wie bei den Zusagen. Dazu darf jede ihre eigenen Punkte
       schreiben (eigene). Lesen darf man den eigenen Stand; die Leitung
       alle, damit sie sieht, wer noch nicht gepackt hat. */
    match /groups/{gid}/events/{eid}/gepackt/{uid} {
      allow get: if inGroup(gid) && (request.auth.uid == uid || leadsGroup(gid));
      allow list: if leadsGroup(gid);

      allow create, update: if inGroup(gid)
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.erledigt is map
                            && request.resource.data.erledigt.size() <= 400
                            && (!('eigene' in request.resource.data)
                                || (request.resource.data.eigene is list && request.resource.data.eigene.size() <= 100))
                            && request.resource.data.keys().hasOnly(['uid', 'erledigt', 'eigene', 'am']);

      allow delete: if (inGroup(gid) && request.auth.uid == uid) || leadsGroup(gid);
    }

    /* Zusagen. Jeder antwortet fuer sich, und die Dokument-ID ist die
       uid — damit kann niemand fuer jemand anderen zusagen, ohne dass
       die Regel es extra verbieten muesste.

       Die Leitung darf loeschen, aber nicht schreiben: eine Zusage,
       die der Trainer selbst eingetragen hat, waere keine Zusage mehr.
       Aufraeumen nach einem ausgeladenen Athleten muss sie koennen. */
    match /groups/{gid}/events/{eid}/zusagen/{uid} {
      allow get, list: if inGroup(gid);

      allow create, update: if inGroup(gid)
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid
                            && request.resource.data.antwort in ['ja', 'nein', 'vielleicht']
                            && request.resource.data.keys().hasOnly(['uid', 'antwort', 'am']);

      allow delete: if (inGroup(gid) && request.auth.uid == uid)
                    || leadsGroup(gid);
    }

    /* In eine Gruppe tragen Kopf und Trainer ein (v.35.49.0) — fuer ihre
       Termine galt das schon (leadsGroup), fuer die Reisen nicht: jedes
       Mitglied konnte in jede seiner Gruppen eine anlegen, aendern,
       verschieben und loeschen. Eine alte Familie, die ihr Kopf noch
       nicht als Gruppe uebernommen hat, leitet ihr Kopf oder ihre
       Verwaltung, wie vorher. */
    function tripLeitung(gid) {
      return gid is string
        && gid.size() > 0
        && (
          leadsGroup(gid)
          || (!exists(/databases/$(database)/documents/groups/$(gid)) && managesFamily(gid))
        );
    }

    match /trips/{tripId} {
      allow get: if tripGruppe(resource.data.get('familyId', ''))
                 || hasGuestAccess(tripId);
      allow list: if tripGruppe(resource.data.get('familyId', ''));
      allow create: if tripLeitung(request.resource.data.get('familyId', ''))
                    && request.resource.data.createdBy == request.auth.uid;
      // Verschieben nur zwischen Gruppen, die man leitet. Mitglieder haken
      // Programmpunkte ab — und sonst nichts.
      allow update: if (
                      tripLeitung(resource.data.get('familyId', ''))
                      && tripLeitung(request.resource.data.get('familyId', ''))
                      && request.resource.data.get('createdBy', '')
                        == resource.data.get('createdBy', '')
                    )
                    || (
                      tripGruppe(resource.data.get('familyId', ''))
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['itineraryDone', 'itineraryUpdatedAt'])
                    );
      allow delete: if tripLeitung(resource.data.get('familyId', ''));
    }

    match /activities/{id} {
      allow read: if canUseTrip(resource.data.get('tripId', ''));
      allow create: if canUseTrip(request.resource.data.get('tripId', ''))
                    && request.resource.data.keys().hasOnly([
                      'tripId', 'name', 'done', 'createdAt'
                    ]);
      allow update: if canUseTrip(resource.data.get('tripId', ''))
                    && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['name', 'done']);
      allow delete: if canUseTrip(resource.data.get('tripId', ''));
    }

    match /calendarDays/{id} {
      allow create: if isMember()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow read, delete: if isMember()
                          && resource.data.ownerUid == request.auth.uid;
      allow update: if isMember()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
    }

    match /attachments/{id} {
      allow read: if canUseAttachmentParent(resource.data.get('parent', ''));
      allow create: if canUseAttachmentParent(request.resource.data.get('parent', ''))
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.size is number
                    && request.resource.data.size <= 950000
                    && request.resource.data.keys().hasOnly([
                      'parent', 'scope', 'name', 'type', 'size', 'dataUrl', 'by', 'at'
                    ]);
      allow update: if false;
      allow delete: if canUseAttachmentParent(resource.data.get('parent', ''));
    }

    // Everything else is denied by default.
  }
}
