# OneDrive / FUSE temporary files (created by cloud sync)
.fuse_hidden*
**/.fuse_hidden*

# Editor / perl in-place temp work files
XX[A-Za-z0-9][A-Za-z0-9]*
*.tmp
*.swp
*~

# OS noise
.DS_Store
Thumbs.db

# Self-hosted mail worker secrets and local dependencies
mailer/.env
mailer/node_modules/
mailer/service-account*.json
**/*service-account*.json
*.log
dev/node_modules/

# Einmal-Skripte aus einer Umbauaktion, gehoeren nicht ins Repo
dev/_scratch/
__pycache__/

# Maschinenlokale Harness-Einstellungen
.claude/settings.local.json

# Cloudflare-Worker: lokaler Zustand und Abhaengigkeiten
worker/.wrangler/
worker/node_modules/

# Abzug der Live-Regeln fuer einen Vergleich — nie committen
firestore.rules.live

# Design-Audit-Archive gehoeren nicht ins Repo — sie sind Zulieferung,
# kein Quelltext, und schleppen Binaerdaten in jede Historie.
*.zip
